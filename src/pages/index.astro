---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Dati aperti sul traffico aereo mondiale"
  description="FlyItalyADSB raccoglie dati ADS-B e MLAT da oltre 3.200 ricevitori in tutto il mondo per ricerca meteorologica e aeronautica. Rete no-profit nata in Italia."
>

  <!-- HERO -->
  <section class="relative" style="height:90vh;min-height:560px">

    <!-- Not lazy: this iframe fills the hero, which is on-screen at first
         paint (height:90vh) — it's the likely LCP element, and `loading="lazy"`
         was actively delaying exactly the content guaranteed to be visible. -->
    <iframe
      src="https://mappa.flyitalyadsb.com?hideSidebar&hideButtons"
      title="Mappa ADS-B live"
      class="absolute inset-0 w-full h-full border-0"
      sandbox="allow-scripts allow-same-origin allow-popups"
    ></iframe>

    <div class="absolute inset-0 pointer-events-none"
         style="background:linear-gradient(to bottom, #070d1acc 0%, #070d1a22 30%, #070d1a22 60%, #070d1aff 100%)">
    </div>
    <div class="absolute inset-0 pointer-events-none"
         style="background:linear-gradient(to right, #070d1acc 0%, transparent 60%)">
    </div>

    <div class="absolute inset-0 flex items-center px-6 sm:px-12 lg:px-20 pt-14 pb-28">
      <div class="max-w-xl">

        <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#7dd3fc;font-family:'JetBrains Mono',monospace">
          rete globale · dati non filtrati
        </p>

        <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-4" style="color:#f0f9ff">
          Dati ADS-B aperti<br />
          <span style="color:#38bdf8">rete globale</span><br />
          nata in Italia
        </h1>

        <p class="text-slate-400 text-lg leading-relaxed mb-8 max-w-md">
          Oltre 3.200 ricevitori sparsi nel mondo ci inviano ADS-B e Mode-S
          direttamente, con multilaterazione nostra — inclusi i militari. No-profit, non filtrati.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="https://mappa.flyitalyadsb.com" target="_blank" rel="noopener"
             class="px-5 py-2.5 rounded-lg font-medium text-sm no-underline transition-all"
             style="background:#38bdf8;color:#070d1a"
             onmouseover="this.style.background='#7dd3fc'"
             onmouseout="this.style.background='#38bdf8'">
            Esplora la mappa →
          </a>
          <a href="/ricerca"
             class="px-5 py-2.5 rounded-lg font-medium text-sm no-underline transition-all text-slate-200 hover:text-white"
             style="background:#ffffff10;border:1px solid #ffffff18"
             onmouseover="this.style.background='#ffffff18'"
             onmouseout="this.style.background='#ffffff10'">
            Ricerca
          </a>
        </div>

      </div>
    </div>

    <!-- Live readout: aerei ora + msg/sec are real values from the same
         stats.json this page already polled for the old badge; msg/sec is
         derived client-side from the delta of the cumulative counter, not
         invented. Feeder count and coverage are the same static claims used
         in copy elsewhere on the site (never presented as live). -->
    <div class="hud-panel absolute left-0 right-0 bottom-0 mx-6 sm:mx-12 lg:mx-20 mb-6 sm:mb-8 rounded-lg overflow-hidden">
      <div class="hud-readout">
        <div>
          <div class="k">aerei ora</div>
          <div class="v accent"><span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse inline-block mr-1.5" style="margin-bottom:2px"></span><span id="live-count">—</span></div>
        </div>
        <div>
          <div class="k">msg/sec</div>
          <div class="v" id="live-mps">—</div>
        </div>
        <div>
          <div class="k">feeder diretti</div>
          <div class="v">3.200+</div>
        </div>
        <div>
          <div class="k">copertura</div>
          <div class="v">globale</div>
        </div>
      </div>
    </div>

  </section>

  <!-- 3 PILLARS -->
  <section class="py-20 px-6 sm:px-12 lg:px-20 max-w-7xl mx-auto">

    <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-8">Cosa raccogliamo</p>

    <table class="spec-table">
      <tr>
        <td class="k">ADS-B globale</td>
        <td class="d">Feed di oltre 3.200 ricevitori che alimentano noi direttamente, da Europa, Americhe, Asia e Oceania, più adsb.lol e theairtraffic.com.</td>
        <td class="tag" style="color:#475569">aircraft.json · 0.2s</td>
      </tr>
      <tr>
        <td class="k">Triangolazione MLAT</td>
        <td class="d">Multilaterazione su aerei senza transponder ADS-B completo, inclusi militari. Server nostro, oltre 1.800 ricevitori sincronizzati — <a href="/rete" class="text-sky-400 no-underline hover:text-sky-300">numero esatto e data →</a></td>
        <td class="tag" style="color:#475569">mlat-server · porta 30100</td>
      </tr>
      <tr>
        <td class="k">Mode-S BDS50/BDS60</td>
        <td class="d">True Air Speed, magnetic heading e Mach number via Mode-S Comm-B. Dati per la ricostruzione del vento troposferico.</td>
        <td class="tag" style="color:#475569">BDS50 · BDS60</td>
      </tr>
    </table>

  </section>

  <!-- RICERCA IN EVIDENZA -->
  <section class="py-20 px-6 sm:px-12 lg:px-20 max-w-7xl mx-auto border-t" style="border-color:#1e3048">

    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-2">Ricerca in corso</p>
        <h2 class="text-2xl font-bold text-slate-100">Dall'airspace alla scienza</h2>
      </div>
      <a href="/ricerca" class="text-sm text-sky-400 hover:text-sky-300 no-underline">Tutti i progetti →</a>
    </div>

    <!-- Featured: weather-32 -->
    <a href="/ricerca/weather" class="block p-8 rounded-2xl border no-underline group transition-all hover:border-sky-400/30 mb-6"
       style="background:#0f1929;border-color:#1e3048">
      <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="text-xs px-2.5 py-1 rounded-full font-medium" style="background:#38bdf815;color:#7dd3fc;border:1px solid #38bdf830">Meteorologia</span>
            <span class="text-xs px-2.5 py-1 rounded-full font-medium" style="background:#10b98115;color:#34d399;border:1px solid #10b98130">In corso</span>
          </div>
          <h3 class="text-xl font-bold text-slate-100 mb-3 group-hover:text-white transition-colors">
            Misura del vento troposferico da aeromobili in volo
          </h3>
          <p class="text-slate-400 text-sm leading-relaxed mb-4 max-w-2xl">
            Gli aerei commerciali in volo sono sensori meteorologici distribuiti ad alta quota.
            Estraendo le componenti di vento dai messaggi Mode-S (BDS50/BDS60) e confrontandole
            con le rianalisi ERA5 e i profili IASI, stiamo validando la qualità del dato aeronautico
            come sorgente meteorologica indipendente.
          </p>
          <div class="flex flex-wrap gap-6 text-sm">
            <div>
              <div class="text-xs text-slate-600 uppercase tracking-wider mb-1">Metodo</div>
              <div class="text-slate-300 font-mono text-xs">W = V<sub>ground</sub> − V<sub>air</sub></div>
            </div>
            <div>
              <div class="text-xs text-slate-600 uppercase tracking-wider mb-1">Validazione</div>
              <div class="text-slate-300 text-xs">ERA5 · IASI (MetOp)</div>
            </div>
            <div>
              <div class="text-xs text-slate-600 uppercase tracking-wider mb-1">RMSE tipico</div>
              <div class="text-slate-300 text-xs">6.5–7.4 m/s (u, v)</div>
            </div>
          </div>
        </div>

        <!-- Mini risultati -->
        <div class="shrink-0 w-full lg:w-64 p-5 rounded-xl" style="background:#111e30;border:1px solid #1e3048">
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-4">Mode-S vs ERA5</div>
          <div class="space-y-3">
            {[
              { label: 'Bias u', value: '+0.21 m/s' },
              { label: 'Bias v', value: '+1.77 m/s' },
              { label: 'RMSE u', value: '7.38 m/s' },
              { label: 'RMSE v', value: '6.57 m/s' },
            ].map(row => (
              <div class="flex justify-between items-center">
                <span class="text-xs text-slate-500">{row.label}</span>
                <span class="text-xs font-mono" style="color:#7dd3fc">{row.value}</span>
              </div>
            ))}
          </div>
          <div class="mt-4 pt-3 border-t text-xs text-slate-600" style="border-color:#1e3048">23 giu 2025</div>
        </div>

      </div>
    </a>

  </section>

  <!-- SVILUPPATORI & AGENTI AI -->
  <section class="py-20 px-6 sm:px-12 lg:px-20 max-w-7xl mx-auto border-t" style="border-color:#1e3048">

    <div class="rounded-2xl p-8 sm:p-12" style="background:linear-gradient(135deg,#0f1929 0%,#111e30 100%);border:1px solid #1e3048">
      <div class="flex flex-col lg:flex-row gap-8 lg:items-center justify-between mb-8">
        <div class="max-w-lg">
          <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:#38bdf8">Sviluppatori & agenti AI</p>
          <h2 class="text-2xl font-bold text-slate-100 mb-3">Interroga i dati via API o dalla tua AI</h2>
          <p class="text-slate-400 text-sm leading-relaxed">
            REST API pubblica e server MCP per Claude, ChatGPT e altri agenti — chiave gratuita e
            istantanea via email, nessuna approvazione manuale. Vedi anche
            <a href="/llms.txt" class="text-sky-400 no-underline hover:text-sky-300">llms.txt</a>.
          </p>
        </div>
        <a href="/dati/api"
           class="shrink-0 px-6 py-3 rounded-lg font-medium text-sm text-center no-underline transition-all"
           style="background:#38bdf8;color:#070d1a"
           onmouseover="this.style.background='#7dd3fc'"
           onmouseout="this.style.background='#38bdf8'">
          Documentazione API →
        </a>
      </div>
      <div class="grid sm:grid-cols-3 gap-4">
        {[
          { label: 'find_aircraft', desc: 'Cerca per hex ICAO, callsign o registrazione' },
          { label: 'aircraft_near', desc: 'Aerei in un raggio, ovunque nel mondo' },
          { label: 'special_traffic', desc: 'Traffico militare, PIA o LADD' },
        ].map(t => (
          <div class="p-4 rounded-lg" style="background:#0a1320;border:1px solid #1e3048">
            <code class="text-xs font-mono" style="color:#a78bfa">{t.label}</code>
            <p class="text-xs text-slate-500 mt-1">{t.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </section>

  <!-- COMMUNITY CTA -->
  <section class="py-20 px-6 sm:px-12 lg:px-20 max-w-7xl mx-auto border-t" style="border-color:#1e3048">

    <div class="rounded-2xl p-8 sm:p-12 flex flex-col sm:flex-row gap-8 items-start sm:items-center justify-between"
         style="background:linear-gradient(135deg,#0f1929 0%,#111e30 100%);border:1px solid #1e3048">

      <div class="max-w-lg">
        <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:#38bdf8">Contribuisci</p>
        <h2 class="text-2xl font-bold text-slate-100 mb-3">Fai parte della rete</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          La qualità dei dati dipende dalla densità della rete. Con un Raspberry Pi e un'antenna RTL-SDR
          puoi contribuire a coprire la tua area. Tutto il necessario costa meno di €30.
        </p>
      </div>

      <div class="flex flex-col gap-3 shrink-0">
        <a href="/community/feeder"
           class="px-6 py-3 rounded-lg font-medium text-sm text-center no-underline transition-all"
           style="background:#38bdf8;color:#070d1a"
           onmouseover="this.style.background='#7dd3fc'"
           onmouseout="this.style.background='#38bdf8'">
          Diventa feeder →
        </a>
        <a href="/chi-siamo"
           class="px-6 py-3 rounded-lg font-medium text-sm text-center no-underline transition-all text-slate-300 hover:text-white"
           style="background:#ffffff08;border:1px solid #ffffff14"
           onmouseover="this.style.background='#ffffff12'"
           onmouseout="this.style.background='#ffffff08'">
          Chi siamo
        </a>
      </div>

    </div>

  </section>

</Layout>

<script>
// stats.json's `messages` field is readsb's cumulative message counter, not
// a rate — msg/sec is derived from the delta between two polls, same way
// tar1090's own stats panel computes it. Left as "—" until a second sample
// exists rather than showing a made-up number on first paint.
let prevSample: { messages: number; now: number } | null = null;

async function updateLiveCount() {
  try {
    const res = await fetch('https://api.flyitalyadsb.com/api/stats.json', { cache: 'no-store' });
    const data = await res.json();
    // /api/stats.json ora ritorna il conteggio globale (aircraft = numero), non l'array.
    const n = typeof data.aircraft === 'number' ? data.aircraft : null;
    const el = document.getElementById('live-count');
    if (el && n !== null) el.textContent = n.toLocaleString('it-IT');

    if (typeof data.messages === 'number' && typeof data.now === 'number') {
      const mpsEl = document.getElementById('live-mps');
      if (prevSample && mpsEl) {
        const dMsg = data.messages - prevSample.messages;
        const dt = data.now - prevSample.now;
        if (dt > 0 && dMsg >= 0) {
          mpsEl.textContent = Math.round(dMsg / dt).toLocaleString('it-IT');
        }
      }
      prevSample = { messages: data.messages, now: data.now };
    }
  } catch {}
}
updateLiveCount();
setInterval(updateLiveCount, 10000);
</script>
