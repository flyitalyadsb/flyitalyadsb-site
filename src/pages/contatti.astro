---
import Layout from '../layouts/Layout.astro';

const channels = [
  {
    title: 'Domande generali e supporto',
    desc: 'Domande sulla rete, sul tuo feeder, sulla mappa o su qualsiasi altro aspetto del progetto.',
    label: 'info@flyitalyadsb.com',
    href: 'mailto:info@flyitalyadsb.com?subject=Domanda%20generale',
  },
  {
    title: 'Accesso ai dati per ricerca',
    desc: "Dataset storici, dati Mode-S grezzi, file MLAT CSV — per ricerca universitaria o istituzionale. Includi una breve descrizione del progetto e dell'istituzione di riferimento.",
    label: 'info@flyitalyadsb.com',
    href: 'mailto:info@flyitalyadsb.com?subject=Richiesta%20accesso%20dati%20per%20la%20ricerca',
  },
  {
    title: 'Problemi tecnici e GitHub',
    desc: 'Bug, contributi al codice o domande sui sorgenti: readsb fork, mlat-server, flarm-ogn-to-sbs.',
    label: 'github.com/flyitalyadsb ↗',
    href: 'https://github.com/flyitalyadsb',
    external: true,
  },
];
---

<Layout
  title="Contattaci"
  description="Contatta FlyItalyADSB: domande generali, richieste di accesso ai dati per la ricerca, problemi tecnici o GitHub. Rispondiamo entro 48 ore, niente moduli né bot."
>
  <div class="pt-24 pb-20 px-6 sm:px-12 lg:px-20 max-w-4xl mx-auto">

    <div class="mb-10">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">Progetto</p>
      <h1 class="text-4xl font-bold text-slate-100 mb-4">Contattaci</h1>
      <p class="text-slate-400 max-w-2xl leading-relaxed text-lg">
        FlyItalyADSB è gestita da volontari, non da un customer service: scrivici e ti risponde
        una persona vera, non un ticketing system. Scegli il canale più adatto qui sotto.
      </p>
    </div>

    <div class="tag-row mb-12">
      <span><b>48 ore</b> · tempo medio di risposta</span>
      <span><b>Nessun modulo</b> · solo email dirette</span>
      <span><b>Volontari</b> · + infrastruttura Nesso Labs</span>
    </div>

    <div class="grid sm:grid-cols-3 gap-4 mb-14">
      {channels.map((c) => (
        <div class="p-5 rounded-xl border flex flex-col" style="background:#0f1929;border-color:#1e3048">
          <h3 class="font-semibold text-slate-200 mb-1 text-sm">{c.title}</h3>
          <p class="text-xs text-slate-500 leading-relaxed mb-4 flex-1">{c.desc}</p>
          <a href={c.href}
             target={c.external ? '_blank' : undefined}
             rel={c.external ? 'noopener' : undefined}
             class="text-sm text-sky-400 no-underline hover:text-sky-300 break-all">
            {c.label}
          </a>
        </div>
      ))}
    </div>

    <div class="p-6 rounded-xl border" style="background:#0a1320;border-color:#1e3048">
      <p class="text-sm text-slate-400 leading-relaxed">
        Problemi con il tuo feeder? Prima di scriverci, dai un'occhiata a
        <a href="/community/stato-feeder" class="text-sky-400 no-underline">I miei dati arrivano?</a> —
        risolve la maggior parte dei casi in autonomia. Per tutto il resto,
        <a href="mailto:info@flyitalyadsb.com" class="text-sky-400 no-underline">info@flyitalyadsb.com</a>
        resta il canale unico per qualsiasi richiesta: rispondiamo entro 48 ore.
      </p>
    </div>

  </div>
</Layout>
