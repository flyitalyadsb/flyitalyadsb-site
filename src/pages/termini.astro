---
import Layout from '../layouts/Layout.astro';

// Condizioni del servizio API. ⚠️ Da far rivedere a un legale prima del
// go-live dei piani a pagamento (nesso-infra docs/FLYITALYADSB-BILLING.md,
// passo 6): il testo regola l'accesso al servizio, la licenza dei dati resta
// CC BY-SA 4.0. Ogni modifica sostanziale: nuova data qui sotto + email agli
// utenti con almeno 30 giorni di preavviso (punto 9).
const VERSION = '19 ottobre 2026';

const sections = [
  {
    h: '1. Chi fornisce il servizio',
    p: [
      'Il servizio API di FlyItalyADSB (REST API su api.flyitalyadsb.com, server MCP su flyitalyadsb.com/mcp) è fornito da Nesso Labs S.r.l., Via Carlo Cattaneo 3, 25121 Brescia (BS), Italia, P.IVA IT04754860981. Contatto: admin@flyitalyadsb.com.',
    ],
  },
  {
    h: '2. Il servizio',
    p: [
      "L'API dà accesso ai dati di traffico aereo raccolti dalla rete FlyItalyADSB (posizioni in tempo reale e storico recente). Il servizio è fornito \"best effort\": non garantiamo un livello di servizio (SLA) né tempi di risposta, sia dell'API sia alle email, perché FlyItalyADSB è una community e i piani a pagamento coprono solo i costi di server e banda. Un SLA si può concordare solo con un accordo enterprise scritto.",
    ],
  },
  {
    h: '3. Chiavi e piani',
    p: [
      "Ogni API key è personale e legata a un indirizzo email. I piani disponibili, con prezzi e limiti (richieste al minuto per chiave, richieste al mese, raggio massimo), sono descritti su flyitalyadsb.com/dati/api. L'uso commerciale è consentito con ogni piano, Free compreso, entro i limiti del piano. Le richieste oltre i limiti ricevono una risposta di errore (429 o 403) e non sono conteggiate.",
      "Una chiave può stare dentro un'app o un dispositivo che distribuisci o vendi, e il tuo server può usarla per servire gli utenti del tuo prodotto, anche tenendo le risposte in cache. Le richieste di tutti i dispositivi, gli utenti e i server di quel prodotto contano insieme sui limiti del piano della chiave: usa una chiave per prodotto e non dividere lo stesso uso su più chiavi.",
    ],
  },
  {
    h: '4. Pagamenti, rinnovo e disdetta',
    p: [
      "I piani a pagamento sono abbonamenti mensili a rinnovo automatico, venduti per nostro conto da Stripe tramite il servizio Link, che agisce come rivenditore (merchant of record): applica le imposte dovute nel paese dell'acquirente, emette ricevute e fatture e gestisce pagamenti, rimborsi e contestazioni secondo i propri termini.",
      "Puoi cambiare piano o disdire in qualsiasi momento da link.com; la disdetta ha effetto alla fine del periodo già pagato, poi la chiave torna al piano Free. Restano fermi i diritti che la legge riconosce ai consumatori.",
    ],
  },
  {
    h: '5. Dati e licenza',
    p: [
      'I dati sono pubblicati con licenza Creative Commons Attribuzione - Condividi allo stesso modo 4.0 (CC BY-SA 4.0): chi li riutilizza deve citare "FlyItalyADSB" con un link a flyitalyadsb.com e distribuire le opere derivate con la stessa licenza. Un piano a pagamento paga l\'accesso al servizio e limiti più alti, non una licenza diversa sui dati.',
    ],
  },
  {
    h: '6. Usi non consentiti',
    p: [
      "Non è consentito: usare i dati per la sicurezza delle persone, il controllo del traffico aereo o la navigazione; dare la propria chiave a terzi perché la usino nei loro prodotti, o aggirare i limiti (più chiavi o più indirizzi IP per lo stesso uso); rivendere o ridistribuire i dati in tempo reale come API o feed per prodotti di altri senza un accordo enterprise; usare il servizio per attività illecite, per pedinare o molestare persone.",
    ],
  },
  {
    h: '7. Sospensione',
    p: [
      "In caso di abuso, di violazione di queste condizioni o di traffico che mette a rischio il servizio per gli altri utenti possiamo limitare, sospendere o revocare una chiave, avvisando per email quando possibile.",
    ],
  },
  {
    h: '8. Responsabilità',
    p: [
      "I dati arrivano da ricevitori di volontari e possono essere incompleti, in ritardo o errati: sono forniti così come sono. Nei limiti consentiti dalla legge Nesso Labs S.r.l. non risponde di danni indiretti o della perdita di profitti derivanti dall'uso del servizio; restano ferme le tutele inderogabili del Codice del Consumo.",
    ],
  },
  {
    h: '9. Modifiche',
    p: [
      "Le modifiche a piani, limiti o a queste condizioni vengono comunicate per email agli utenti con almeno 30 giorni di anticipo e valgono dalla data indicata. Chi ha un piano a pagamento può disdire prima che entrino in vigore.",
    ],
  },
  {
    h: '10. Legge applicabile',
    p: [
      "Si applica la legge italiana. Per le controversie con i consumatori è competente il foro del luogo di residenza del consumatore; negli altri casi il foro di Brescia.",
    ],
  },
];

// Plain text in `sections`, links added here: escape first, then turn the
// known addresses into links (no HTML in the copy itself).
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const linkify = (t: string) =>
  esc(t)
    .replace(/admin@flyitalyadsb\.com/g, '<a href="mailto:admin@flyitalyadsb.com" class="text-sky-400 no-underline hover:text-sky-300">admin@flyitalyadsb.com</a>')
    .replace(/\bflyitalyadsb\.com\/(?:en\/data|dati)\/api\b/g, (m) => `<a href="https://${m}/" class="text-sky-400 no-underline hover:text-sky-300">${m}</a>`)
    .replace(/\blink\.com\b/g, '<a href="https://link.com" rel="noopener" class="text-sky-400 no-underline hover:text-sky-300">link.com</a>');
const anchor = (h: string) => 's' + h.split('.')[0];
---

<Layout title="Condizioni del servizio API" description="Condizioni del servizio API di FlyItalyADSB: piani, pagamenti, licenza dei dati, usi consentiti.">
  <div class="pt-24 pb-20 px-6 sm:px-12 lg:px-20 max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold text-slate-100 mb-3">Condizioni del servizio API</h1>
    <p class="text-sm text-slate-500 mb-10">Versione del {VERSION}</p>
    <nav aria-label="Indice" class="mb-10 rounded-xl border p-5" style="background:#0a1320;border-color:#1e3048">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">Indice</p>
      <ol class="grid sm:grid-cols-2 gap-x-6 gap-y-1.5 text-sm">
        {sections.map((s) => (
          <li><a href={`#${anchor(s.h)}`} class="text-slate-300 no-underline hover:text-sky-300">{s.h}</a></li>
        ))}
      </ol>
    </nav>
    {sections.map((s) => (
      <section id={anchor(s.h)} class="mb-8 scroll-mt-24">
        <h2 class="text-lg font-semibold text-slate-100 mb-3">{s.h}</h2>
        {s.p.map((para) => <p class="text-sm text-slate-400 leading-relaxed mb-3" set:html={linkify(para)} />)}
      </section>
    ))}
  </div>
</Layout>
