---
import Layout from '../../layouts/Layout.astro';

// Periodi coperti da /v2/history. Stato verificato il 2026-10-18: se cambia
// (nuovi giorni recuperati, archivi ripristinati) aggiornare anche la versione EN.
const coverage = [
  {
    period: '10/04/2022 – 04/10/2023',
    source: 'Vecchio Virtual Radar Server',
    tone: 'yellow',
    detail:
      'Solo il primo e l\'ultimo punto di ogni volo: il tratto in mezzo è una stima, e sulla mappa è tratteggiato. Ogni file ha il campo "version": "vrs-basestation-import/1". 529 giorni.',
  },
  {
    period: '25/07/2023 – 27/06/2024',
    source: 'readsb, server precedente',
    tone: 'purple',
    detail:
      'Traccia completa, ma con lacune: 206 giorni in tutto. Settembre 2023 manca; agosto 2023 e giugno 2024 sono parziali (15 e 5 giorni); febbraio e aprile 2024 hanno 2 e 1 giorno. Nei 26 giorni in comune con il periodo VRS, l\'API restituisce la traccia completa.',
  },
  {
    period: 'dal 17/08/2026',
    source: 'readsb, server attuale',
    tone: 'green',
    detail: 'Traccia completa, aggiornata ogni giorno.',
  },
];

const toneColor = { purple: '#a78bfa', yellow: '#fbbf24', green: '#34d399' };
---

<Layout
  title="Archivio storico"
  description="Archivio storico ADS-B di FlyItalyADSB dal 2022: tracce di volo per aeromobile, self-serve via API REST. Include il progetto di ricerca weather32 su vento e temperatura da Mode-S."
>
  <div class="pt-24 pb-20 px-6 sm:px-12 lg:px-20 max-w-4xl mx-auto">

    <div class="mb-14">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">
        <a href="/dati" class="text-slate-600 hover:text-slate-400 no-underline">Dati</a>
        <span class="mx-2">/</span>
        <span class="text-slate-500">Archivio</span>
      </p>
      <h1 class="text-4xl font-bold text-slate-100 mb-4">Archivio storico</h1>
      <p class="text-slate-400 max-w-2xl leading-relaxed">
        FlyItalyADSB conserva le tracce di volo raccolte dalla rete dal 2022: posizione, quota,
        velocità e prua di ogni aeromobile nel tempo. Tutto lo storico è disponibile in self-serve
        tramite la REST API, senza bisogno di richiedere l'accesso.
      </p>
    </div>

    <!-- Cosa contiene l'archivio -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-100 mb-6">Contenuto dell'archivio</h2>

      <div class="space-y-4">
        {[
          {
            tag: 'Globe history',
            color: 'purple',
            title: 'Storico posizioni per aeromobile',
            desc: "Un file JSON per aeromobile per giorno, nel formato di readsb: posizione, quota, velocità e prua durante la giornata.",
            size: 'dal 10/04/2022 · ~2,5 GB/giorno · tutto self-serve',
          },
          {
            tag: 'Ricerca meteo',
            color: 'green',
            title: 'Vento e temperatura da Mode-S (weather32)',
            desc: "Il progetto weather32 deriva vento e temperatura in quota dai messaggi Mode-S BDS50/60 (True Air Speed, prua magnetica, IAS, numero di Mach), validati contro ERA5/IASI. È un'analisi di ricerca, non un archivio esportabile: i dati grezzi non sono organizzati in un dataset scaricabile su richiesta.",
            size: null,
            link: { href: '/ricerca/weather', label: 'Vedi i risultati della ricerca →' },
          },
        ].map(item => (
          <div class="p-6 rounded-xl border flex flex-col sm:flex-row gap-5" style="background:#0f1929;border-color:#1e3048">
            <div class="shrink-0">
              <span class="text-xs px-2.5 py-1 rounded font-mono font-semibold"
                    style={`background:${item.color === 'purple' ? '#8b5cf615' : item.color === 'yellow' ? '#f59e0b15' : '#10b98115'};color:${item.color === 'purple' ? '#a78bfa' : item.color === 'yellow' ? '#fbbf24' : '#34d399'};border:1px solid ${item.color === 'purple' ? '#8b5cf630' : item.color === 'yellow' ? '#f59e0b30' : '#10b98130'}`}>
                {item.tag}
              </span>
            </div>
            <div class="flex-1">
              <h3 class="font-semibold text-slate-100 mb-1">{item.title}</h3>
              <p class="text-sm text-slate-400 leading-relaxed mb-2">{item.desc}</p>
              {item.size && <span class="text-xs font-mono text-slate-600">{item.size}</span>}
              {item.link && (
                <a href={item.link.href} class="block text-xs font-mono text-sky-400 hover:text-sky-300 no-underline">{item.link.label}</a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Copertura -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-100 mb-2">Copertura</h2>
      <p class="text-sm text-slate-400 leading-relaxed mb-6 max-w-2xl">
        Lo storico viene da tre fonti diverse, con un livello di dettaglio diverso.
        Tra fine giugno 2024 e metà agosto 2026 al momento non ci sono dati disponibili.
      </p>
      <div class="space-y-3">
        {coverage.map(c => (
          <div class="p-5 rounded-xl border flex flex-col sm:flex-row gap-3 sm:gap-6" style="background:#0f1929;border-color:#1e3048">
            <div class="sm:w-52 shrink-0">
              <div class="font-mono text-sm font-semibold" style={`color:${toneColor[c.tone]}`}>{c.period}</div>
              <div class="text-xs text-slate-500 mt-1">{c.source}</div>
            </div>
            <p class="flex-1 text-sm text-slate-400 leading-relaxed">{c.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Self-serve -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-100 mb-6">Come accedere allo storico Globe history</h2>
      <div class="p-6 rounded-xl border" style="background:#0f1929;border-color:#1e3048">
        <table class="spec-table" style="margin-bottom:1rem">
          <tr>
            <td class="k">GET /v2/history/{'{icao}'}</td>
            <td class="d">Date con storico disponibile per un aeromobile, su tutto il periodo coperto.</td>
          </tr>
          <tr>
            <td class="k">GET /v2/history/{'{icao}'}/{'{data}'}</td>
            <td class="d">Traccia (posizione, quota, velocità, prua) di un aeromobile in un giorno.</td>
          </tr>
        </table>
        <p class="text-sm text-slate-400 leading-relaxed mb-3">
          Stessa API key e stessi limiti del piano del resto di <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">/v2/*</code> —
          vedi la <a href="/dati/api#rest-api" class="text-sky-400 no-underline hover:text-sky-300">documentazione API</a> per come ottenere una chiave.
        </p>
        <p class="text-sm text-slate-400 leading-relaxed">
          L'header <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">X-History-Source</code> indica
          da dove arriva il giorno: <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">local</code> (disco
          del server) o <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">r2</code> (archivio). La prima
          richiesta di un giorno d'archivio può metterci un po' di più.
        </p>
      </div>
    </section>

    <!-- Accesso -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-100 mb-6">Estrazioni più ampie</h2>

      <div class="grid sm:grid-cols-2 gap-5">

        <div class="p-6 rounded-xl border" style="background:#0f1929;border-color:#38bdf830">
          <div class="flex items-center gap-2 mb-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="1.5">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="text-sm font-semibold text-slate-100">Ricerca e casi particolari</span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed mb-4">
            Per estrazioni bulk (molti aeromobili o periodi lunghi) o progetti di ricerca
            universitaria/istituzionale, scrivici con una descrizione del progetto.
          </p>
          <a href="/contatti"
             class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium no-underline transition-all"
             style="background:#38bdf815;color:#7dd3fc;border:1px solid #38bdf830"
             onmouseover="this.style.background='#38bdf825'"
             onmouseout="this.style.background='#38bdf815'">
            Contattaci →
          </a>
        </div>

        <div class="p-6 rounded-xl border" style="background:#0f1929;border-color:#1e3048">
          <div class="flex items-center gap-2 mb-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01" stroke-linecap="round"/>
            </svg>
            <span class="text-sm font-semibold text-slate-300">Licenza</span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">
            I dati distribuiti sono licenziati <strong class="text-slate-300">CC BY-SA 4.0</strong>.
            Attribuzione richiesta; derivati con la stessa licenza.
            Dati MLAT militari: verificare applicabilità prima dell'uso pubblico.
          </p>
        </div>

      </div>
    </section>

    <!-- Citazione -->
    <div class="rounded-xl p-5 border" style="background:#0a1320;border-color:#1e3048">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Come citare</div>
      <code class="block text-xs font-mono p-3 rounded leading-relaxed" style="background:#0f1929;color:#94a3b8">
        FlyItalyADSB (flyitalyadsb.com) · Dati ADS-B/MLAT · Licenza CC BY-SA 4.0<br />
        Infrastruttura: Nesso Labs · nessolabs.it
      </code>
    </div>

  </div>
</Layout>
