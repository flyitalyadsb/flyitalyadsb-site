---
import Layout from '../../layouts/Layout.astro';
import ApiPlans from '../../components/ApiPlans.astro';
import { PLANS, freeLimitsFrom } from '../../data/plans';
import { faqsFor } from '../../data/faq';
import FaqList from '../../components/FaqList.astro';

const SITE = 'https://flyitalyadsb.com';

// The questions marked `api` in src/data/faq.ts (the full list is /faq/).
const faqs = faqsFor((f) => f.api).map((f) => f.it);

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Plans as schema.org offers — the same prices and limits the Plans section
// shows (src/data/plans.ts); structured data must match visible content.
const offersJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'FlyItalyADSB API',
  serviceType: 'API dati ADS-B in tempo reale',
  provider: { '@type': 'Organization', name: 'Nesso Labs S.r.l.', vatID: 'IT04754860981', url: 'https://nessolabs.it' },
  url: `${SITE}/dati/api/`,
  offers: PLANS.map((p) => ({
    '@type': 'Offer',
    name: p.id.charAt(0).toUpperCase() + p.id.slice(1),
    price: p.priceEur.toFixed(2),
    priceCurrency: 'EUR',
    url: `${SITE}/dati/api/#piani`,
    ...(p.priceEur > 0 && {
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: p.priceEur.toFixed(2),
        priceCurrency: 'EUR',
        valueAddedTaxIncluded: false,
        billingDuration: 'P1M',
        unitText: 'mese',
      },
    }),
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Dati', item: `${SITE}/dati/` },
    { '@type': 'ListItem', position: 3, name: 'API e agenti AI', item: `${SITE}/dati/api/` },
  ],
};

const mcpCallExample = `POST https://flyitalyadsb.com/mcp
Content-Type: application/json
X-Api-Key: <la-tua-chiave>

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"aircraft_near","arguments":{"airport":"FCO","limit":5}}}`;
---

<Layout
  title="API, MCP e piani"
  description="REST API v2 e server MCP di FlyItalyADSB per sviluppatori e agenti AI: chiave gratuita in pochi secondi, anche per uso commerciale, e piani da 9 €/mese per volumi più alti."
  jsonLd={[faqJsonLd, offersJsonLd, breadcrumbJsonLd]}
>
  <div class="pt-24 pb-20 px-6 sm:px-12 lg:px-20 max-w-5xl mx-auto">

    <div class="mb-10">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">
        <a href="/dati/" class="text-slate-600 hover:text-slate-400 no-underline">Dati</a>
        <span class="mx-2">/</span>
        <span class="text-slate-500">API e agenti AI</span>
      </p>
      <h1 class="text-4xl font-bold text-slate-100 mb-4">API e agenti AI</h1>
      <p class="text-slate-400 max-w-2xl leading-relaxed">
        Oltre alla mappa, i dati di FlyItalyADSB sono interrogabili programmaticamente: una REST API
        per sviluppatori e un server MCP (Model Context Protocol) che permette ad agenti AI come
        Claude o ChatGPT di rispondere a domande sul traffico aereo in tempo reale, ovunque nel mondo.
      </p>
    </div>

    <nav class="page-index mb-10" aria-label="Indice della pagina">
      <a href="#piani"><span>01</span>Piani</a>
      <a href="#api-key"><span>02</span>Chiave gratuita</a>
      <a href="#rest-api"><span>03</span>REST API</a>
      <a href="#mcp"><span>04</span>Server MCP</a>
      <a href="#come-collegarlo"><span>05</span>Come collegarlo a Claude</a>
      <a href="#faq"><span>06</span>FAQ</a>
      <a href="/dati/api/docs/"><span>07</span>Documentazione</a>
    </nav>

    <!-- At-a-glance readout — the reference specs a developer scans for
         first, before reading any prose. -->
    <div class="hud-panel rounded-lg overflow-hidden mb-14">
      <div class="hud-readout">
        <div><div class="k">rest base url</div><div class="v" style="font-size:13px">api.flyitalyadsb.com/v2</div></div>
        <div><div class="k">mcp endpoint</div><div class="v" style="font-size:13px">flyitalyadsb.com/mcp</div></div>
        <div><div class="k">auth</div><div class="v accent">X-Api-Key</div></div>
        <div><div class="k">piani</div><div class="v">free<span style="font-size:11px;color:#8391a7"> · da 9 €</span></div></div>
      </div>
    </div>

    <ApiPlans lang="it" />

    <!-- Auth signup -->
    <div id="api-key" class="rounded-xl p-8 border scroll-mt-24 mb-14" style="background:#0a1320;border-color:#1e3048">
      <h3 class="font-semibold text-slate-100 mb-2">Ottieni una API key</h3>
      <p class="text-sm text-slate-400 leading-relaxed mb-6">
        REST API e server MCP condividono la stessa chiave, passata nell'header <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">X-Api-Key</code>.
        Istantanea e gratuita: inserisci un'email e ti arriva un link che mostra la chiave una volta sola
        (la chiave non viaggia mai per email). Se la richiedi di nuovo con la stessa email, la vecchia continua
        a funzionare finché non apri il nuovo link, poi la sostituisce la nuova
        (è anche il modo per recuperarla se l'hai persa).
        Hai già una chiave? Piano, consumi e rigenerazione da
        <a href="/dati/api/account/" class="text-sky-400 no-underline hover:text-sky-300">La mia API</a>.
      </p>
      <form id="key-form" class="space-y-3" novalidate>
        <div class="grid sm:grid-cols-2 gap-3">
          <div>
            <label for="key-email" class="block text-xs text-slate-400 mb-1.5">Email</label>
            <input type="email" id="key-email" name="email" required autocomplete="email" aria-describedby="key-status" placeholder="la-tua-email@esempio.com"
                 class="px-3 py-2.5 rounded-lg text-sm w-full"
                 style="background:#111e30;color:#e2e8f0;border:1px solid var(--color-input-border)" />
          </div>
          <div>
            <label for="key-name" class="block text-xs text-slate-400 mb-1.5">Nome o progetto <span class="text-slate-500">(opzionale)</span></label>
            <input type="text" id="key-name" name="name" maxlength="200"
                 class="px-3 py-2.5 rounded-lg text-sm w-full"
                 style="background:#111e30;color:#e2e8f0;border:1px solid var(--color-input-border)" />
          </div>
        </div>
        <div>
          <label for="key-use-case" class="block text-xs text-slate-400 mb-1.5">A cosa la usi? <span class="text-slate-500">(opzionale)</span></label>
          <input type="text" id="key-use-case" name="use_case" maxlength="500"
                 class="px-3 py-2.5 rounded-lg text-sm w-full"
                 style="background:#111e30;color:#e2e8f0;border:1px solid var(--color-input-border)" />
        </div>
        <div class="flex items-center gap-4">
          <button type="submit" id="key-submit"
                  class="px-5 py-2.5 rounded-lg font-medium text-sm transition-all"
                  style="background:#38bdf815;color:#7dd3fc;border:1px solid #38bdf830"
                  onmouseover="this.style.background='#38bdf825'"
                  onmouseout="this.style.background='#38bdf815'">
            Invia il link via email →
          </button>
          <p id="key-status" class="text-sm" role="status"></p>
        </div>
        <p class="text-xs text-slate-500">Se questa email ha già una chiave gratuita, continua a funzionare finché non apri il link: da lì la sostituisce la nuova.</p>
      </form>
    </div>

    <!-- REST API -->
    <section id="rest-api" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">REST API</h2>
      <p class="text-slate-400 text-sm leading-relaxed mb-6">
        Base URL <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">https://api.flyitalyadsb.com/v2</code>,
        risposte JSON, autenticazione via header <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">X-Api-Key</code>.
      </p>
      <table class="spec-table">
        {[
          { path: '/icao/{hex}', desc: 'Un aeromobile per indirizzo ICAO a 24 bit.' },
          { path: '/callsign/{callsign}', desc: 'Un aeromobile per nominativo/numero di volo.' },
          { path: '/reg/{reg}', desc: 'Un aeromobile per marche di registrazione.' },
          { path: '/lat/{lat}/lon/{lon}/dist/{km}', desc: 'Tutti gli aeromobili in un raggio da un punto, record completi — funziona ovunque nel mondo, non solo in Italia.' },
          { path: '/mil', desc: 'Traffico militare attualmente tracciato.' },
          { path: '/pia', desc: 'Aeromobili con indirizzo ICAO privato (Privacy ICAO Address).' },
          { path: '/ladd', desc: 'Aeromobili nel programma FAA Limiting Aircraft Data Displayed.' },
          { path: '/history/{icao}', desc: "Date con storico disponibile per un aeromobile — vedi l'archivio storico." },
          { path: '/history/{icao}/{data}', desc: 'Traccia completa (posizione, quota, velocità, prua) di un aeromobile in un giorno.' },
        ].map((e) => (
          <tr>
            <td class="k">GET {e.path}</td>
            <td class="d">{e.desc}</td>
          </tr>
        ))}
      </table>
      <p class="text-xs text-slate-500 mt-4">
        Piano Free: 30 richieste/minuto per chiave, 300.000 al mese e raggio fino a 500 km dal {freeLimitsFrom('it')} (fino ad allora 100 richieste/minuto per IP); i piani a pagamento hanno limiti propri per chiave (vedi <a href="#piani" class="text-sky-400 no-underline hover:text-sky-300">Piani</a>). Le richieste senza <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">X-Api-Key</code> vengono respinte a livello edge.
      </p>
      <p class="text-xs text-slate-500 mt-2">
        Uso commerciale consentito con ogni piano, entro i suoi limiti, anche dentro app e dispositivi venduti. Rivendere i dati come API o feed per
        altri, SLA o volumi oltre il Business richiedono un accordo enterprise — <a href="/contatti/" class="text-sky-400 no-underline hover:text-sky-300">contattaci</a>.
      </p>
    </section>

    <!-- MCP -->
    <section id="mcp" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">Server MCP per agenti AI</h2>
      <p class="text-slate-400 text-sm leading-relaxed mb-6">
        Il <a href="https://modelcontextprotocol.io" target="_blank" rel="noopener" class="text-sky-400 no-underline">Model Context Protocol</a>
        è lo standard con cui assistenti come Claude o ChatGPT chiamano strumenti esterni. Il nostro server espone
        questi strumenti su
        <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">https://flyitalyadsb.com/mcp</code>:
      </p>
      <table class="spec-table" style="margin-bottom:1.5rem">
        {[
          { name: 'find_aircraft', desc: 'Cerca un aeromobile per hex ICAO, callsign o registrazione.' },
          { name: 'aircraft_near', desc: 'Tutti gli aeromobili in un raggio da un punto (o da un aeroporto italiano per nome), con record completi — il tool più usato.' },
          { name: 'special_traffic', desc: 'Traffico militare, PIA (privacy) o LADD attualmente tracciato.' },
          { name: 'aircraft_history', desc: "Traccia storica di un aeromobile per un giorno, o le date disponibili — self-serve, dal 2022 (vedi l'archivio per la copertura)." },
          { name: 'aircraft_profile', desc: 'Quello che sappiamo di un aereo: identità, stato live, riepilogo dello storico, link a mappa e foto.' },
          { name: 'overflights', desc: 'Gli aerei passati sopra un luogo (coordinate, aeroporto o la tua posizione) tra due istanti, dal 17/08/2026.' },
          { name: 'notable_traffic', desc: 'Emergenze (7500/7600/7700), militari e altri aerei notevoli visti in una zona, fino a 7 giorni.' },
          { name: 'set_my_location / clear_my_location', desc: 'Salva o cancella la tua posizione, per «vicino a me».' },
        ].map((t) => (
          <tr>
            <td class="k" style="color:#a78bfa">{t.name}</td>
            <td class="d">{t.desc}</td>
          </tr>
        ))}
      </table>
      <h3 id="come-collegarlo" class="text-lg font-semibold text-slate-100 mb-3 mt-8 scroll-mt-24">Come collegarlo a Claude</h3>
      <ol class="space-y-2 mb-6 text-sm text-slate-400 list-decimal list-inside marker:text-slate-600">
        <li>Su <a href="https://claude.ai/customize/connectors" target="_blank" rel="noopener" class="text-sky-400 no-underline">claude.ai</a>, apri la pagina <strong class="text-slate-300">Connettori</strong> e clicca <strong class="text-slate-300">"Aggiungi connettore personalizzato"</strong>.</li>
        <li>Dagli un nome, es. "FlyItalyADSB", e incolla l'URL <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">https://flyitalyadsb.com/mcp</code>.</li>
        <li>Come autenticazione lascia <strong class="text-slate-300">"Accedi ora"</strong> (Claude la rileva da solo) e come client OAuth <strong class="text-slate-300">"Usa l'identità pubblicata di Claude"</strong>, poi aggiungi il connettore.</li>
        <li>Premi <strong class="text-slate-300">Connetti</strong>: si apre una pagina di FlyItalyADSB. Scrivi la tua email, poi il codice di 6 cifre che ti arriva, e premi <strong class="text-slate-300">Consenti</strong>. Se non hai ancora una chiave API, la creiamo gratis in quel momento.</li>
        <li>Prova chiedendo a Claude qualcosa come <em>"che aerei ci sono ora vicino a Roma Fiumicino?"</em></li>
      </ol>
      <p class="text-xs text-slate-500 leading-relaxed mb-6">
        Puoi scollegarlo quando vuoi da <a href="/dati/api/account/" class="text-sky-400 no-underline">La mia API</a>.
        Da <a href="https://code.claude.com/docs/en/mcp-quickstart" target="_blank" rel="noopener" class="text-sky-400 no-underline">Claude Code</a> o da un client senza OAuth funziona anche con la chiave:
        <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">claude mcp add --transport http flyitalyadsb https://flyitalyadsb.com/mcp --header "X-Api-Key: ‹la-tua-chiave›"</code>
      </p>

      <!-- Illustrative mockup, not a literal screenshot: Claude's actual UI can
           differ slightly and would go stale fast if copied pixel-for-pixel. -->
      <div class="rounded-xl border overflow-hidden mb-2" style="border-color:#1e3048">
        <div class="px-4 py-2 flex items-center gap-2" style="background:#111e30;border-bottom:1px solid #1e3048">
          <span class="w-2 h-2 rounded-full" style="background:#f87171"></span>
          <span class="w-2 h-2 rounded-full" style="background:#fbbf24"></span>
          <span class="w-2 h-2 rounded-full" style="background:#34d399"></span>
          <span class="ml-2 text-xs font-semibold text-slate-500">claude.ai — Connettori</span>
        </div>
        <div class="p-5 space-y-3" style="background:#0a1320">
          <div>
            <div class="text-xs text-slate-500 mb-1">Nome</div>
            <div class="px-3 py-2 rounded text-sm text-slate-300" style="background:#111e30;border:1px solid #1e3048">FlyItalyADSB</div>
          </div>
          <div>
            <div class="text-xs text-slate-500 mb-1">URL server MCP remoto</div>
            <div class="px-3 py-2 rounded text-sm font-mono" style="background:#111e30;border:1px solid #1e3048;color:#7dd3fc">https://flyitalyadsb.com/mcp</div>
          </div>
          <div>
            <div class="text-xs text-slate-500 mb-1">Autenticazione</div>
            <div class="px-3 py-2 rounded text-sm text-slate-300" style="background:#111e30;border:1px solid #1e3048">Accedi ora &middot; Usa l'identità pubblicata di Claude</div>
          </div>
        </div>
      </div>
      <p class="text-xs text-slate-600 mb-8">Mockup illustrativo — l'interfaccia reale del tuo client può variare leggermente.</p>

      <h3 class="text-lg font-semibold text-slate-100 mb-3">Per altri client MCP</h3>
      <p class="text-slate-400 text-sm leading-relaxed mb-3">
        Gli altri client MCP con OAuth si collegano allo stesso modo, con Connetti. Dal tuo codice, o da un client
        senza OAuth, usa la chiave nell'header X-Api-Key, anche con una chiamata raw:
      </p>
      <pre class="p-4 rounded-lg text-xs overflow-auto leading-relaxed" style="background:#0a1320;color:#94a3b8;border:1px solid #1e3048"><code>{mcpCallExample}</code></pre>
    </section>

    <!-- FAQ — same content as faqJsonLd above; that structured data must
         match what's actually visible on the page, and until now it had no
         visible counterpart at all. -->
    <section id="faq" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-bold text-slate-100 mb-6">Domande frequenti</h2>
      <FaqList faqs={faqsFor((f) => f.api)} lang="it" />
      <p class="mt-4 text-sm"><a href="/faq/" class="text-sky-400 no-underline hover:text-sky-300">Tutte le domande frequenti →</a></p>
    </section>

  </div>

  <script>
    import { identify, track } from '../../lib/analytics';

    const form = document.getElementById('key-form') as HTMLFormElement;
    const submitBtn = document.getElementById('key-submit') as HTMLButtonElement;
    const status = document.getElementById('key-status') as HTMLParagraphElement;

    function setStatus(text: string, color: string) {
      status.textContent = text;
      status.style.color = color;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('key-email') as HTMLInputElement).value.trim();
      const name = (document.getElementById('key-name') as HTMLInputElement).value.trim();
      const useCase = (document.getElementById('key-use-case') as HTMLInputElement).value.trim();

      submitBtn.disabled = true;
      setStatus('Invio in corso…', '#94a3b8');

      try {
        const res = await fetch('https://api.flyitalyadsb.com/v2/keys', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, name: name || undefined, use_case: useCase || undefined, lang: 'it' }),
        });
        if (res.status === 202) identify(email);
        track('api_key_requested', { status: res.status });
        if (res.status === 202) {
          setStatus('Fatto — controlla la tua email: c\'è il link per vedere la chiave.', '#34d399');
          form.reset();
        } else if (res.status === 429) {
          setStatus('Hai già richiesto una chiave di recente — riprova tra qualche minuto.', '#fbbf24');
        } else if (res.status === 409) {
          setStatus('Richiesta già in corso per questa email — riprova tra un istante.', '#fbbf24');
        } else if (res.status === 413) {
          setStatus('Nome o descrizione troppo lunghi, accorciali e riprova.', '#f87171');
        } else {
          const body = await res.json().catch(() => null);
          setStatus(body?.error || 'Qualcosa è andato storto, riprova.', '#f87171');
        }
      } catch {
        setStatus('Impossibile contattare il servizio, riprova tra poco.', '#f87171');
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</Layout>
