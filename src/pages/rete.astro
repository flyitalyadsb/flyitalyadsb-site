---
import Layout from '../layouts/Layout.astro';

// I numeri della rete sono aggiornati a mano: meglio una data esplicita che un
// dato che invecchia in silenzio. Ultima misura: 9 agosto 2026.
const AGGIORNATO = '9 agosto 2026';

// Ricevitori MLAT che dichiarano la propria posizione (1635 su ~1856), classificati
// per area dalle coordinate reali, non da geolocalizzazione dell'IP.
const AREE = [
  { nome: 'Resto d’Europa', n: 792, pct: 48.4 },
  { nome: 'Nord America', n: 572, pct: 35.0 },
  { nome: 'Italia e dintorni', n: 123, pct: 7.5, evidenzia: true },
  { nome: 'Asia', n: 90, pct: 5.5 },
  { nome: 'Oceania', n: 33, pct: 2.0 },
  { nome: 'Sud America, Africa, altro', n: 25, pct: 1.5 },
];
---

<Layout
  title="La rete"
  description="La rete di ricevitori ADS-B di FlyItalyADSB: oltre 3.000 feeder privati in tutto il mondo, MLAT proprio, copertura globale."
>
  <div class="pt-24 pb-20 px-6 sm:px-12 lg:px-20 max-w-7xl mx-auto">

    <div class="mb-14">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">Infrastruttura</p>
      <h1 class="text-4xl font-bold text-slate-100 mb-4">La rete</h1>
      <p class="text-slate-400 max-w-2xl leading-relaxed">
        FlyItalyADSB è nata in Italia ed è oggi una rete globale: oltre <strong class="text-slate-200">3.000
        ricevitori privati</strong> sparsi nel mondo inviano i loro dati <em>direttamente</em> ai nostri
        server, non attraverso intermediari. La densità più alta resta sull'Europa e sul Mediterraneo,
        ma più di un terzo dei ricevitori si trova in Nord America.
      </p>
    </div>

    <!-- Numeri della rete -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-16">
      {[
        { n: '3.051', l: 'ricevitori attivi', d: 'indirizzi univoci che alimentano adesso' },
        { n: '3.004', l: 'in BEAST', d: 'flusso ADS-B e Mode-S diretto' },
        { n: '1.856', l: 'in MLAT', d: 'di cui 1.809 fanno anche BEAST' },
        { n: '~11.900', l: 'aeromobili', d: 'tracciati simultaneamente' },
      ].map(k => (
        <div class="p-5 rounded-xl border" style="background:#0f1929;border-color:#1e3048">
          <div class="text-3xl font-bold mb-1" style="color:#38bdf8">{k.n}</div>
          <div class="text-sm font-semibold text-slate-200 mb-1">{k.l}</div>
          <div class="text-xs text-slate-500 leading-relaxed">{k.d}</div>
        </div>
      ))}
    </div>

    <!-- Architettura rete -->
    <div class="grid md:grid-cols-2 gap-6 mb-16">

      <div class="p-6 rounded-xl border" style="background:#0f1929;border-color:#1e3048">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:#38bdf815;border:1px solid #38bdf830">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="1.5">
              <path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0" stroke-linecap="round"/>
              <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" stroke-linecap="round"/>
            </svg>
          </div>
          <h2 class="font-semibold text-slate-100">Feeder diretti</h2>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed mb-4">
          Ricevitori privati che inviano a noi in prima persona, dall'Italia al resto d'Europa,
          dalle due Americhe all'Asia e all'Oceania. Ogni ricevitore copre un raggio fino a 400 km
          e invia dati ADS-B e Mode-S in tempo reale al server di ingestione centrale.
          <span class="text-slate-300">Sono loro la copertura globale</span>, non gli aggregatori.
        </p>
        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1 border-b" style="border-color:#1e3048">
            <span class="text-slate-500">Protocollo in</span>
            <span class="text-slate-300 font-mono">BEAST TCP · porta 4905</span>
          </div>
          <div class="flex justify-between py-1 border-b" style="border-color:#1e3048">
            <span class="text-slate-500">Mode-S EHS</span>
            <span class="text-slate-300 font-mono">BDS50 · BDS60 · BDS44</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-slate-500">MLAT</span>
            <span class="text-slate-300 font-mono">porta 30100</span>
          </div>
        </div>
      </div>

      <div class="p-6 rounded-xl border" style="background:#0f1929;border-color:#1e3048">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:#38bdf815;border:1px solid #38bdf830">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="1.5">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h2 class="font-semibold text-slate-100">Aggregatori internazionali</h2>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed mb-4">
          Il server readsb-globe si connette anche a <strong class="text-slate-300">adsb.lol</strong> e
          <strong class="text-slate-300">theairtraffic.com</strong>, con i loro dati MLAT integrati nel
          feed. Servono a <span class="text-slate-300">infittire</span> le aree dove i nostri ricevitori
          sono radi: la portata globale ce l'abbiamo già dai feeder diretti.
        </p>
        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1 border-b" style="border-color:#1e3048">
            <span class="text-slate-500">adsb.lol</span>
            <span class="text-slate-300 font-mono">BEAST in · SBS MLAT in</span>
          </div>
          <div class="flex justify-between py-1 border-b" style="border-color:#1e3048">
            <span class="text-slate-500">theairtraffic.com</span>
            <span class="text-slate-300 font-mono">BEAST in · SBS MLAT in</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-slate-500">OGN (ultraleggeri)</span>
            <span class="text-slate-300 font-mono">FLARM/FANET → SBS</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Distribuzione geografica -->
    <div class="mb-16">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">Da dove arrivano</p>
      <h2 class="text-2xl font-bold text-slate-100 mb-3">Dove sono i ricevitori</h2>
      <p class="text-slate-400 text-sm leading-relaxed max-w-2xl mb-8">
        Posizioni dichiarate dai 1.635 ricevitori MLAT che le condividono — coordinate reali,
        non geolocalizzazione dell'indirizzo IP. L'Italia è dove la rete è nata e dove la
        densità per km² resta più alta, ma è ormai una piccola parte del totale.
      </p>

      <div class="rounded-xl border p-6" style="background:#0f1929;border-color:#1e3048">
        <div class="space-y-4">
          {AREE.map(a => (
            <div>
              <div class="flex items-baseline justify-between mb-1.5 gap-4">
                <span class={a.evidenzia ? 'text-sm font-semibold text-slate-100' : 'text-sm text-slate-300'}>
                  {a.nome}
                </span>
                <span class="text-xs font-mono shrink-0" style="color:#94a3b8">
                  {a.n} · {a.pct}%
                </span>
              </div>
              <div class="h-2 rounded-full overflow-hidden" style="background:#0a1320">
                <div
                  class="h-full rounded-full"
                  style={`width:${a.pct}%;background:${a.evidenzia ? '#38bdf8' : '#31527a'}`}
                ></div>
              </div>
            </div>
          ))}
        </div>
        <p class="text-xs text-slate-600 mt-6 pt-5" style="border-top:1px solid #1e3048">
          Conteggio per indirizzo: più ricevitori dietro la stessa connessione contano una volta
          sola, quindi i totali sono una stima per difetto. Aggiornato al {AGGIORNATO}.
        </p>
      </div>
    </div>

    <!-- Pipeline dati -->
    <div class="mb-16">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-8">Pipeline</p>

      <div class="relative">
        <!-- Linea verticale connettore -->
        <div class="absolute left-5 top-8 bottom-8 w-px" style="background:linear-gradient(to bottom, #38bdf830, #38bdf810)"></div>

        <div class="space-y-4">

          {[
            {
              step: '01',
              title: 'Ricezione',
              desc: 'I feeder inviano dati BEAST TCP al server readsb-ingest (porta 4905). Simultaneamente, readsb-globe riceve da adsb.lol e theairtraffic.com.',
              tags: ['readsb-ingest', 'readsb-globe']
            },
            {
              step: '02',
              title: 'MLAT',
              desc: 'I client MLAT (porta 30100) inviano misurazioni temporizzate al mlat-server. Con almeno 4 ricevitori sincronizzati, il server triangola la posizione degli aeromobili senza GPS.',
              tags: ['mlat-server', 'porta 30100']
            },
            {
              step: '03',
              title: 'Aggregazione',
              desc: 'readsb-globe fonde tutti i feed: feeder diretti, MLAT risultante, adsb.lol, theairtraffic.com, OGN. Produce aircraft.json ogni 200ms e aggiorna lo storico heatmap.',
              tags: ['aircraft.json', '0.2s', 'heatmap']
            },
            {
              step: '04',
              title: 'Distribuzione',
              desc: 'I dati vengono serviti alla mappa tar1090 via socket Unix locale e usati dalla pipeline meteorologica weather-32.',
              tags: ['tar1090', 'weather-32']
            },
          ].map(item => (
            <div class="flex gap-6 pl-12 relative">
              <div class="absolute left-0 top-4 w-10 h-10 rounded-full flex items-center justify-center text-xs font-mono font-bold shrink-0"
                   style="background:#0f1929;border:1px solid #38bdf830;color:#38bdf8">
                {item.step}
              </div>
              <div class="flex-1 p-5 rounded-xl border mb-0" style="background:#0f1929;border-color:#1e3048">
                <h3 class="font-semibold text-slate-100 mb-1">{item.title}</h3>
                <p class="text-sm text-slate-400 leading-relaxed mb-3">{item.desc}</p>
                <div class="flex flex-wrap gap-2">
                  {item.tags.map(tag => (
                    <span class="text-xs px-2 py-0.5 rounded font-mono" style="background:#111e30;color:#64748b">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}

        </div>
      </div>
    </div>

    <!-- CTA feeder -->
    <div class="rounded-2xl p-8 border flex flex-col sm:flex-row gap-6 items-center"
         style="background:linear-gradient(135deg,#0f1929 0%,#111e30 100%);border-color:#1e3048">
      <div class="flex-1">
        <h3 class="font-bold text-slate-100 text-xl mb-2">Contribuisci con il tuo ricevitore</h3>
        <p class="text-sm text-slate-400">
          Più ricevitori significano migliore copertura MLAT e dati Mode-S più densi per la ricerca meteorologica.
        </p>
      </div>
      <a href="/community/feeder"
         class="shrink-0 px-6 py-3 rounded-lg font-medium text-sm no-underline transition-all"
         style="background:#38bdf8;color:#070d1a"
         onmouseover="this.style.background='#7dd3fc'"
         onmouseout="this.style.background='#38bdf8'">
        Diventa feeder →
      </a>
    </div>

  </div>
</Layout>
