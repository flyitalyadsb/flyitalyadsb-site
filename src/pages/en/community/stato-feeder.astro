---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Is my data arriving?"
  description="Check in real time whether your ADS-B receiver is feeding the FlyItalyADSB network: BEAST and MLAT connection status."
>
  <div class="pt-24 pb-20 px-6 sm:px-12 lg:px-20 max-w-3xl mx-auto">

    <div class="mb-10">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">
        <a href="/en/community/feeder" class="text-slate-600 hover:text-slate-400 no-underline">Community</a>
      </p>
      <h1 class="text-4xl font-bold text-slate-100 mb-4">Is my data arriving?</h1>
      <p class="text-slate-400 max-w-2xl leading-relaxed">
        This page checks whether we are receiving data from your IP address right now.
        No sign-up, nothing to type in: we simply look at where the request came from.
      </p>
    </div>

    <!-- Result -->
    <div id="esito" class="rounded-xl p-6 border mb-10" style="background:#0f1929;border-color:#1e3048">
      <p class="text-sm text-slate-400">Checking…</p>
    </div>

    <!-- Shown only when BEAST or MLAT comes back negative -->
    <section class="mb-12" id="aiuto" hidden>
      <h2 class="text-2xl font-bold text-slate-100 mb-4">Not recognised?</h2>
      <p class="text-slate-400 text-sm leading-relaxed mb-6">
        Before assuming something is broken: this page checks the address your <em>browser</em>
        comes from. If you are on a phone over mobile data, in another building, or behind a VPN,
        that address differs from your receiver's and the answer will be negative even with a
        perfectly healthy feed.
      </p>

      <div class="mb-8">
        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">
          Check from the receiver itself
        </div>
        <p class="text-slate-400 text-sm leading-relaxed mb-3">
          Run this <span class="text-slate-300">on the machine that sends the data</span>: it leaves
          from the same address as the feed, so the answer is really about your receiver.
        </p>
        <pre class="p-4 rounded-lg text-xs overflow-auto leading-relaxed" style="background:#0a1320;color:#94a3b8;border:1px solid #1e3048"><code>curl https://api.flyitalyadsb.com/api/am_i_feeding</code></pre>
      </div>

      <h3 class="font-semibold text-slate-100 mb-3">If it is negative from there too</h3>
      <ul class="space-y-2 text-sm text-slate-400 leading-relaxed list-disc pl-5">
        <li>
          Check the destination:
          <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">dati.flyitalyadsb.com</code>
          port <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">4905</code> for BEAST,
          <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">30100</code> for MLAT.
        </li>
        <li>
          Confirm the connection is actually open:
          <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">ss -tnp | grep 4905</code>
        </li>
        <li>
          On ultrafeeder, check the container logs:
          <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">docker logs -f ultrafeeder</code>
        </li>
        <li>A connection opened just now can take up to a minute to show up here.</li>
      </ul>
    </section>

    <!-- What the two states mean -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-100 mb-6">What this means</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="p-5 rounded-xl border" style="background:#0f1929;border-color:#1e3048">
          <h3 class="font-semibold text-slate-100 mb-2">BEAST</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            The stream of ADS-B messages your receiver decodes and sends us. This is the one that
            matters: if it is active, your data is going into the network.
          </p>
        </div>
        <div class="p-5 rounded-xl border" style="background:#0f1929;border-color:#1e3048">
          <h3 class="font-semibold text-slate-100 mb-2">MLAT</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Multilateration, which derives the position of aircraft that don't broadcast one by
            comparing arrival times across receivers. It is optional: you can feed BEAST without
            doing MLAT. <a href="/en/community/mlat" class="text-sky-400 no-underline">How it works →</a>
          </p>
        </div>
      </div>
    </section>

    <div class="rounded-xl p-6 border" style="background:#0a1320;border-color:#1e3048">
      <h3 class="font-semibold text-slate-100 mb-2">Not a feeder yet?</h3>
      <p class="text-sm text-slate-400 leading-relaxed mb-4">
        A Raspberry Pi, an RTL-SDR dongle and an antenna are all it takes. The guide covers
        everything, from hardware to configuration.
      </p>
      <a href="/en/community/feeder"
         class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium no-underline transition-all"
         style="background:#38bdf815;color:#7dd3fc;border:1px solid #38bdf830"
         onmouseover="this.style.background='#38bdf825'"
         onmouseout="this.style.background='#38bdf815'">
        Become a feeder →
      </a>
    </div>

  </div>
</Layout>

<script>
  // "Are my data arriving?" — the question my.flyitalyadsb.com/am_i_feeding used to
  // answer before the k8s migration, and which feeders have been asking by email ever
  // since. The endpoint replies ONLY about the address the request came from: it takes
  // no caller-supplied IP, because that would make it a way to enumerate the network.
  const ENDPOINT = 'https://api.flyitalyadsb.com/api/am_i_feeding';

  const box = document.getElementById('esito');
  const help = document.getElementById('aiuto');

  const esc = (s) =>
    String(s).replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

  function row(active, name, since) {
    const colour = active ? '#34d399' : '#64748b';
    const label = active ? 'active' : 'no connection';
    // How long WE have seen this connection, not how long the receiver has been on:
    // it restarts from zero when our own services do. Under a minute is just noise.
    let age = '';
    if (active && since) {
      const min = Math.floor((Date.now() / 1000 - since) / 60);
      if (min >= 60) age = ` · for ${Math.floor(min / 60)} h`;
      else if (min >= 1) age = ` · for ${min} min`;
    }
    return `
      <div class="flex items-center gap-3 py-2">
        <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:${colour}"></span>
        <span class="text-sm font-semibold text-slate-200" style="min-width:4.5rem">${name}</span>
        <span class="text-sm" style="color:${colour}">${label}</span>
        <span class="text-xs text-slate-600">${age}</span>
      </div>`;
  }

  // Deliberately distinct from "you are not feeding": telling someone they are down when
  // we simply cannot tell is exactly what makes them write in.
  function inconclusive(title, detail, ip) {
    box.innerHTML = `
      <h2 class="text-lg font-semibold text-slate-100 mb-2">${esc(title)}</h2>
      <p class="text-sm text-slate-400 leading-relaxed">${esc(detail)}</p>` +
      (ip
        ? `<p class="text-xs text-slate-600 mt-4 pt-4" style="border-top:1px solid #1e3048">
             Address checked: <span class="font-mono text-slate-500">${esc(ip)}</span>
           </p>`
        : '');
  }

  async function check() {
    let res;
    try {
      res = await fetch(ENDPOINT, { cache: 'no-store' });
    } catch {
      return inconclusive(
        'Check failed',
        'We could not reach the service. Try again in a few minutes — it does not mean your feed is down.',
      );
    }

    if (res.status === 503) {
      return inconclusive(
        'We cannot check right now',
        'The status check is temporarily unavailable. This is not about your feed: try again in a few minutes.',
      );
    }
    if (!res.ok) {
      return inconclusive(
        'Check failed',
        `The service returned an error (${res.status}). Try again in a few minutes.`,
      );
    }

    const data = await res.json();

    // Receivers always feed over IPv4 (dati.flyitalyadsb.com is an A record with no
    // AAAA), but the API is Cloudflare-proxied and answers over IPv6 too. A browser
    // on IPv6 therefore reaches us from an address that can never match the feed —
    // saying "not feeding" there would be a guaranteed false negative.
    if (data.comparable === false) {
      inconclusive(
        'We cannot compare this address',
        'Your browser reaches us over IPv6, while receivers send their data over IPv4: the two addresses are not comparable. Use the command below directly on the receiver.',
        data.ip,
      );
      help.hidden = false;
      return;
    }

    const beast = !!(data.feeding && data.feeding.beast);
    const mlat = !!(data.feeding && data.feeding.mlat);
    const since = data.since || {};

    const head = beast
      ? { text: 'Yes, your data is arriving', colour: '#34d399' }
      : { text: 'We are not receiving data from this address', colour: '#f59e0b' };

    box.innerHTML = `
      <h2 class="text-lg font-semibold mb-4" style="color:${head.colour}">${esc(head.text)}</h2>
      ${row(beast, 'BEAST', since.beast || null)}
      ${row(mlat, 'MLAT', since.mlat || null)}
      <p class="text-xs text-slate-600 mt-4 pt-4" style="border-top:1px solid #1e3048">
        Address checked: <span class="font-mono text-slate-500">${esc(data.ip || '')}</span>
      </p>`;

    // Also shown to BEAST-only feeders: usually a deliberate choice, sometimes an
    // MLAT config that was never finished.
    if (!beast || !mlat) help.hidden = false;
  }

  check();
</script>
