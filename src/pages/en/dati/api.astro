---
import Layout from '../../../layouts/Layout.astro';

const SITE = 'https://flyitalyadsb.com';

const faqs = [
  {
    q: 'Do I need an API key?',
    a: 'Yes, for both the REST API (api.flyitalyadsb.com/v2/*) and the MCP server (flyitalyadsb.com/mcp) — same key for both, passed in the X-Api-Key header. It\'s self-service and instant: just an email address, the key arrives by email within seconds, no manual approval.',
  },
  {
    q: 'How do I use the MCP server with Claude or ChatGPT?',
    a: 'Add https://flyitalyadsb.com/mcp as a connector/MCP server in your client\'s settings (e.g. Claude.ai → Settings → Connectors), supplying your X-Api-Key when asked. Then just ask things like "what\'s flying over Fiumicino right now?" or "any military traffic over Rome?" and the agent will call the tools automatically.',
  },
  {
    q: 'What can the MCP server do that the map can\'t?',
    a: 'It returns structured data (JSON) instead of a web page: look up one aircraft by ICAO hex/callsign/registration, list every aircraft within a radius of any point on the planet with full records, and pull filtered lists of military, PIA (privacy), or LADD traffic.',
  },
  {
    q: 'Is the network limited to Italy?',
    a: 'No. FlyItalyADSB was born in Italy but is a global network with 3,000+ direct feeders worldwide — both the REST API and the MCP tools accept coordinates anywhere on the planet, not just Italy.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/en/` },
    { '@type': 'ListItem', position: 2, name: 'Data', item: `${SITE}/en/dati/` },
    { '@type': 'ListItem', position: 3, name: 'API and AI agents', item: `${SITE}/en/dati/api/` },
  ],
};

const mcpCallExample = `POST https://flyitalyadsb.com/mcp
Content-Type: application/json
X-Api-Key: <your-key>

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"aircraft_near","arguments":{"airport":"FCO","limit":5}}}`;
---

<Layout
  title="API and AI agents"
  description="FlyItalyADSB's REST API v2 and MCP server: how to query live aircraft data, for developers and for AI agents like Claude or ChatGPT."
  jsonLd={[faqJsonLd, breadcrumbJsonLd]}
>
  <div class="pt-24 pb-20 px-6 sm:px-12 lg:px-20 max-w-5xl mx-auto">

    <div class="mb-10">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">
        <a href="/en/dati" class="text-slate-600 hover:text-slate-400 no-underline">Data</a>
        <span class="mx-2">/</span>
        <span class="text-slate-500">API and AI agents</span>
      </p>
      <h1 class="text-4xl font-bold text-slate-100 mb-4">API and AI agents</h1>
      <p class="text-slate-400 max-w-2xl leading-relaxed">
        Beyond the map, FlyItalyADSB's data can be queried programmatically: a REST API for
        developers, and an MCP (Model Context Protocol) server that lets AI agents like Claude or
        ChatGPT answer questions about live air traffic anywhere in the world.
      </p>
    </div>

    <nav class="page-index mb-10" aria-label="Page index">
      <a href="#rest-api"><span>01</span>REST API</a>
      <a href="#mcp"><span>02</span>MCP server</a>
      <a href="#connect-claude"><span>03</span>Connect to Claude</a>
      <a href="#faq"><span>04</span>FAQ</a>
      <a href="#api-key"><span>05</span>Get a key</a>
    </nav>

    <!-- At-a-glance readout — the reference specs a developer scans for
         first, before reading any prose. -->
    <div class="hud-panel rounded-lg overflow-hidden mb-14">
      <div class="hud-readout">
        <div><div class="k">rest base url</div><div class="v" style="font-size:13px">api.flyitalyadsb.com/v2</div></div>
        <div><div class="k">mcp endpoint</div><div class="v" style="font-size:13px">flyitalyadsb.com/mcp</div></div>
        <div><div class="k">auth</div><div class="v accent">X-Api-Key</div></div>
        <div><div class="k">rate limit</div><div class="v">300<span style="font-size:11px;color:#64748b">/min/ip</span></div></div>
      </div>
    </div>

    <!-- REST API -->
    <section id="rest-api" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">REST API</h2>
      <p class="text-slate-400 text-sm leading-relaxed mb-6">
        Base URL <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">https://api.flyitalyadsb.com/v2</code>,
        JSON responses, authenticated via the <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">X-Api-Key</code> header.
      </p>
      <table class="spec-table">
        {[
          { path: '/icao/{hex}', desc: 'One aircraft by 24-bit ICAO address.' },
          { path: '/callsign/{callsign}', desc: 'One aircraft by callsign/flight number.' },
          { path: '/reg/{reg}', desc: 'One aircraft by tail registration.' },
          { path: '/lat/{lat}/lon/{lon}/dist/{km}', desc: 'Every aircraft within a radius of a point, full records — works anywhere in the world, not just Italy.' },
          { path: '/mil', desc: 'Currently tracked military traffic.' },
          { path: '/pia', desc: 'Aircraft with a Privacy ICAO Address.' },
          { path: '/ladd', desc: 'Aircraft in the FAA Limiting Aircraft Data Displayed program.' },
        ].map((e) => (
          <tr>
            <td class="k">GET {e.path}</td>
            <td class="d">{e.desc}</td>
          </tr>
        ))}
      </table>
      <p class="text-xs text-slate-500 mt-4">
        Limit: 300 requests/minute per IP. Requests without <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">X-Api-Key</code> are rejected at the edge.
      </p>
    </section>

    <!-- MCP -->
    <section id="mcp" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">MCP server for AI agents</h2>
      <p class="text-slate-400 text-sm leading-relaxed mb-6">
        The <a href="https://modelcontextprotocol.io" target="_blank" rel="noopener" class="text-sky-400 no-underline">Model Context Protocol</a>
        is the standard assistants like Claude or ChatGPT use to call external tools. Our server exposes
        three read-only tools at
        <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">https://flyitalyadsb.com/mcp</code>:
      </p>
      <table class="spec-table" style="margin-bottom:1.5rem">
        {[
          { name: 'find_aircraft', desc: 'Look up one aircraft by ICAO hex, callsign, or registration.' },
          { name: 'aircraft_near', desc: 'Every aircraft within a radius of a point (or an Italian airport by name), full records — the most useful one.' },
          { name: 'special_traffic', desc: 'Currently tracked military, PIA (privacy), or LADD traffic.' },
        ].map((t) => (
          <tr>
            <td class="k" style="color:#a78bfa">{t.name}</td>
            <td class="d">{t.desc}</td>
          </tr>
        ))}
      </table>
      <h3 id="connect-claude" class="text-lg font-semibold text-slate-100 mb-3 mt-8 scroll-mt-24">How to connect it to Claude</h3>
      <ol class="space-y-2 mb-6 text-sm text-slate-400 list-decimal list-inside marker:text-slate-600">
        <li>On <a href="https://claude.ai" target="_blank" rel="noopener" class="text-sky-400 no-underline">claude.ai</a>, open <strong class="text-slate-300">Settings → Connectors</strong> (from your profile menu).</li>
        <li>Click <strong class="text-slate-300">"Add custom connector"</strong>.</li>
        <li>Paste the URL <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">https://flyitalyadsb.com/mcp</code> and give it a name, e.g. "FlyItalyADSB".</li>
        <li>In the connector's advanced settings, add a custom header: <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">X-Api-Key</code> with the key you got by email.</li>
        <li>Save, then try asking Claude something like <em>"what aircraft are near Rome Fiumicino right now?"</em></li>
      </ol>

      <!-- Illustrative mockup, not a literal screenshot: Claude's actual UI can
           differ slightly and would go stale fast if copied pixel-for-pixel. -->
      <div class="rounded-xl border overflow-hidden mb-2" style="border-color:#1e3048">
        <div class="px-4 py-2 flex items-center gap-2" style="background:#111e30;border-bottom:1px solid #1e3048">
          <span class="w-2 h-2 rounded-full" style="background:#f87171"></span>
          <span class="w-2 h-2 rounded-full" style="background:#fbbf24"></span>
          <span class="w-2 h-2 rounded-full" style="background:#34d399"></span>
          <span class="ml-2 text-xs font-semibold text-slate-500">claude.ai — Settings → Connectors</span>
        </div>
        <div class="p-5 space-y-3" style="background:#0a1320">
          <div>
            <div class="text-xs text-slate-500 mb-1">Name</div>
            <div class="px-3 py-2 rounded text-sm text-slate-300" style="background:#111e30;border:1px solid #1e3048">FlyItalyADSB</div>
          </div>
          <div>
            <div class="text-xs text-slate-500 mb-1">Remote MCP server URL</div>
            <div class="px-3 py-2 rounded text-sm font-mono" style="background:#111e30;border:1px solid #1e3048;color:#7dd3fc">https://flyitalyadsb.com/mcp</div>
          </div>
          <div>
            <div class="text-xs text-slate-500 mb-1">Custom headers (advanced)</div>
            <div class="px-3 py-2 rounded text-sm font-mono flex gap-2 items-baseline" style="background:#111e30;border:1px solid #1e3048">
              <span style="color:#a78bfa">X-Api-Key</span><span class="text-slate-600">:</span><span class="text-slate-500">‹your-key›</span>
            </div>
          </div>
        </div>
      </div>
      <p class="text-xs text-slate-600 mb-8">Illustrative mockup — your client's actual UI may look slightly different.</p>

      <h3 class="text-lg font-semibold text-slate-100 mb-3">For other MCP clients</h3>
      <p class="text-slate-400 text-sm leading-relaxed mb-3">
        Any MCP client that supports Streamable HTTP with custom headers (ChatGPT, other assistants, your own
        code) works the same way — including a raw call:
      </p>
      <pre class="p-4 rounded-lg text-xs overflow-auto leading-relaxed" style="background:#0a1320;color:#94a3b8;border:1px solid #1e3048"><code>{mcpCallExample}</code></pre>
    </section>

    <!-- FAQ — same content as faqJsonLd above; that structured data must
         match what's actually visible on the page, and until now it had no
         visible counterpart at all. -->
    <section id="faq" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-bold text-slate-100 mb-6">Frequently asked questions</h2>
      <div class="divide-y" style="border-color:#1e3048;border-top:1px solid #1e3048;border-bottom:1px solid #1e3048">
        {faqs.map((f) => (
          <details class="group" style="border-color:#1e3048">
            <summary class="py-4 cursor-pointer list-none flex items-center justify-between gap-4 text-sm font-semibold text-slate-200 hover:text-white">
              {f.q}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" class="shrink-0 transition-transform group-open:rotate-45">
                <path d="M12 5v14m-7-7h14" stroke-linecap="round"/>
              </svg>
            </summary>
            <p class="text-sm text-slate-400 leading-relaxed pb-4 pr-8">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Auth signup -->
    <div id="api-key" class="rounded-xl p-8 border scroll-mt-24" style="background:#0a1320;border-color:#1e3048">
      <h3 class="font-semibold text-slate-100 mb-2">Get an API key</h3>
      <p class="text-sm text-slate-400 leading-relaxed mb-6">
        The REST API and the MCP server share the same key, passed in the <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">X-Api-Key</code> header.
        Instant and free: enter an email, the key arrives there — it's never shown on this page.
        Requesting again with the same email retires the old key and issues a new one
        (also how to recover a lost key).
      </p>
      <form id="key-form" class="space-y-3" novalidate>
        <div class="grid sm:grid-cols-2 gap-3">
          <input type="email" id="key-email" name="email" required placeholder="you@example.com"
                 class="px-3 py-2.5 rounded-lg text-sm w-full"
                 style="background:#111e30;color:#e2e8f0;border:1px solid #1e3048" />
          <input type="text" id="key-name" name="name" maxlength="200" placeholder="Name or project (optional)"
                 class="px-3 py-2.5 rounded-lg text-sm w-full"
                 style="background:#111e30;color:#e2e8f0;border:1px solid #1e3048" />
        </div>
        <input type="text" id="key-use-case" name="use_case" maxlength="500" placeholder="What will you use it for? (optional)"
               class="px-3 py-2.5 rounded-lg text-sm w-full"
               style="background:#111e30;color:#e2e8f0;border:1px solid #1e3048" />
        <div class="flex items-center gap-4">
          <button type="submit" id="key-submit"
                  class="px-5 py-2.5 rounded-lg font-medium text-sm transition-all"
                  style="background:#38bdf815;color:#7dd3fc;border:1px solid #38bdf830"
                  onmouseover="this.style.background='#38bdf825'"
                  onmouseout="this.style.background='#38bdf815'">
            Email me a key →
          </button>
          <p id="key-status" class="text-sm" role="status"></p>
        </div>
      </form>
    </div>

  </div>

  <script>
    const form = document.getElementById('key-form') as HTMLFormElement;
    const submitBtn = document.getElementById('key-submit') as HTMLButtonElement;
    const status = document.getElementById('key-status') as HTMLParagraphElement;

    function setStatus(text: string, color: string) {
      status.textContent = text;
      status.style.color = color;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('key-email') as HTMLInputElement).value.trim();
      const name = (document.getElementById('key-name') as HTMLInputElement).value.trim();
      const useCase = (document.getElementById('key-use-case') as HTMLInputElement).value.trim();

      submitBtn.disabled = true;
      setStatus('Sending…', '#94a3b8');

      try {
        const res = await fetch('https://api.flyitalyadsb.com/v2/keys', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, name: name || undefined, use_case: useCase || undefined }),
        });
        if (res.status === 202) {
          setStatus('Done — check your email for the key.', '#34d399');
          form.reset();
        } else if (res.status === 429) {
          setStatus('You already requested a key recently — try again in a few minutes.', '#fbbf24');
        } else if (res.status === 409) {
          setStatus('A request for this email is already in progress — try again in a moment.', '#fbbf24');
        } else if (res.status === 413) {
          setStatus('Name or use case is too long — shorten it and try again.', '#f87171');
        } else {
          const body = await res.json().catch(() => null);
          setStatus(body?.error || 'Something went wrong, please try again.', '#f87171');
        }
      } catch {
        setStatus('Could not reach the service, try again shortly.', '#f87171');
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</Layout>
