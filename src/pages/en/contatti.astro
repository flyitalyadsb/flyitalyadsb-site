---
import Layout from '../../layouts/Layout.astro';

const channels = [
  {
    title: 'General questions & support',
    desc: 'Questions about the network, your feeder, the map, or any other aspect of the project.',
    label: 'info@flyitalyadsb.com',
    href: 'mailto:info@flyitalyadsb.com?subject=General%20question',
  },
  {
    title: 'Research data access',
    desc: 'Historical datasets, raw Mode-S data, MLAT CSV files — for university or institutional research. Include a short description of your project and institution.',
    label: 'info@flyitalyadsb.com',
    href: 'mailto:info@flyitalyadsb.com?subject=Research%20data%20access%20request',
  },
  {
    title: 'Technical issues & GitHub',
    desc: 'Bugs, code contributions, or questions about the sources: readsb fork, mlat-server, flarm-ogn-to-sbs.',
    label: 'github.com/flyitalyadsb ↗',
    href: 'https://github.com/flyitalyadsb',
    external: true,
  },
];
---

<Layout
  title="Contact us"
  description="Contact FlyItalyADSB: general questions, research data-access requests, technical issues or GitHub. We reply within 48 hours — no forms, no bots."
>
  <div class="pt-24 pb-20 px-6 sm:px-12 lg:px-20 max-w-4xl mx-auto">

    <div class="mb-10">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">Project</p>
      <h1 class="text-4xl font-bold text-slate-100 mb-4">Contact us</h1>
      <p class="text-slate-400 max-w-2xl leading-relaxed text-lg">
        FlyItalyADSB is run by volunteers, not a customer service desk: write to us and a real
        person replies — not a ticketing system. Pick the channel that fits below.
      </p>
    </div>

    <div class="tag-row mb-12">
      <span><b>48 hours</b> · average response time</span>
      <span><b>No forms</b> · direct email only</span>
      <span><b>Volunteers</b> · + Nesso Labs infrastructure</span>
    </div>

    <div class="grid sm:grid-cols-3 gap-4 mb-14">
      {channels.map((c) => (
        <div class="p-5 rounded-xl border flex flex-col" style="background:#0f1929;border-color:#1e3048">
          <h3 class="font-semibold text-slate-200 mb-1 text-sm">{c.title}</h3>
          <p class="text-xs text-slate-500 leading-relaxed mb-4 flex-1">{c.desc}</p>
          <a href={c.href}
             target={c.external ? '_blank' : undefined}
             rel={c.external ? 'noopener' : undefined}
             class="text-sm text-sky-400 no-underline hover:text-sky-300 break-all">
            {c.label}
          </a>
        </div>
      ))}
    </div>

    <div class="p-6 rounded-xl border" style="background:#0a1320;border-color:#1e3048">
      <p class="text-sm text-slate-400 leading-relaxed">
        Having trouble with your feeder? Before writing in, check
        <a href="/en/community/stato-feeder" class="text-sky-400 no-underline">Is my data arriving?</a> —
        it solves most cases on your own. For everything else,
        <a href="mailto:info@flyitalyadsb.com" class="text-sky-400 no-underline">info@flyitalyadsb.com</a>
        is the single channel for any request: we reply within 48 hours.
      </p>
    </div>

  </div>
</Layout>
