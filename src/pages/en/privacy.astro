---
import Layout from '../../layouts/Layout.astro';
import StatsOptOut from '../../components/StatsOptOut.astro';

// Privacy notice — English version of /privacy (same content; the Italian
// text prevails). ⚠️ Draft for legal review, see the Italian page's note.
const VERSION = '23 October 2026';

const sections = [
  {
    h: '1. Data controller',
    p: [
      'Nesso Labs S.r.l., Via Carlo Cattaneo 3, 25121 Brescia (BS), Italy, VAT IT04754860981. For any request about your data: admin@flyitalyadsb.com.',
    ],
  },
  {
    h: '2. What data we process',
    p: [
      'API keys and My API: your email address, the project name and intended use if you enter them, a fingerprint of the key (the key itself is not stored), creation and last-use dates and the number of requests per day per key. Sign-in to My API uses single-use links and temporary sessions, also stored only as fingerprints.',
      "Subscriptions: plan, status and the customer and subscription identifiers at the payment provider. Payment data (card, billing address, VAT number) is collected and processed directly by the payment provider named in point 4: we never see it.",
      'Requests to the service: IP address, date and time, requested path and user agent, in the technical logs of Cloudflare and of our servers, for security, usage limits and troubleshooting.',
      "Feeders: the IP address your receiver sends data from and, if you provide it, the receiver's position for multilateration. The \"Are my data arriving?\" page uses the request's IP address only to answer that question. If you turn on the feeder perk in My API, we keep with your email the network (IP address) your receiver sends data from, the date of the check and the date of the last data seen, to know how long the perk applies.",
      "Position for “aircraft near me” (optional): if you save it from My API or tell the connected assistant, the position you give, rounded to about 1 km before it is stored, with the name you give it. One per account: a new one replaces the old. The MCP server uses it to answer questions about aircraft near you; like every argument of the assistants' calls, it also appears in the MCP server statistics (below). If the question comes from ChatGPT and you have no saved position, we use the approximate location (the city) that ChatGPT attaches to the request, only for that answer and without keeping it.",
      "Overflight searches (/v2/overflights): the point and time window you give are used to answer and we don't store them in the database. Like every request they appear in the technical logs; if the search comes from an AI assistant, also in the MCP server statistics (below).",
      "Webhooks (paid plans, optional): the URL to send alerts to, the area (point and radius) and the event kinds you choose, a description if you write one, the signing secret and the outcome of each delivery (HTTP status, error, duration), never the content of your server's answers.",
      "Aircraft data: we publish what our receivers pick up over the air, unfiltered: military, PIA and LADD aircraft are flagged, not hidden. Aircraft profiles add no photo links for PIA and LADD aircraft. If an aircraft is yours and you object to the publication of its data, write to admin@flyitalyadsb.com.",
      "Browsing the site and the map (mappa.flyitalyadsb.com): pages visited, clicks, where you came from (referring site and campaign parameters), device and browser type, approximate location derived from the IP address, searches in the FAQ and the outcome of the API forms (requesting a key, signing in to My API, starting and completing a purchase), never the content of the fields. We use an analytics cookie and record visits (movements, clicks and page content; form fields are always hidden and pages that show your key are never recorded). If you type your email into the API forms, we link your browsing to that email. If you opt out (point 7) we only count you anonymously: no cookies, no recording, and to tell visitors apart an irreversible code computed from IP address and browser together with a random value that changes every day.",
      "Use of the API and the MCP server: we link the service's events to the key's email (key issued and claimed, plan changes, requests per day and those rejected by the limits, connected assistants).",
      "AI assistants' calls to the MCP server: for each call, the tool used, the arguments with their values (a position included, if there is one), the answer, duration and errors, the name and version of the assistant and of the model, and a short sentence the assistant writes about what you want to know (without names or addresses, as we ask it). If you connect with your account we link them to your email; calls with a key in the X-Api-Key header stay without an email.",
    ],
  },
  {
    h: '3. Why, and on what basis',
    p: [
      'Providing the service you ask for (key, plan, My API, service emails): performance of a contract, GDPR art. 6(1)(b). Protecting the service from abuse and enforcing limits: legitimate interest, art. 6(1)(f). Legal obligations (accounting and tax): art. 6(1)(c). Statistics on the site, the map and the use of the service, including the analytics cookie, visit recordings and linking to your email: legitimate interest in understanding how they are used and improving them, art. 6(1)(f); you can object at any time (point 7), with no effect on using the site. We do not use your data for advertising and we do not sell it. The saved position is one you give to get that feature (art. 6(1)(b)), and webhooks only serve to send you the alerts you ask for (art. 6(1)(b)). Publishing aircraft data rests on the legitimate interest in offering open air-traffic data (art. 6(1)(f)).',
    ],
  },
  {
    h: '4. Who we entrust it to',
    p: [
      'Cloudflare (content delivery, attack protection, cookieless aggregate site statistics); PostHog Inc. (statistics on the site, the map and the use of the service, and visit recordings, with the data hosted in the European Union); Stripe, through its Link service, which sells the paid plans on our behalf as merchant of record and processes payment data as an independent controller under its own privacy notice; the provider of our transactional email service. Some of these providers also process data outside the European Union, with the safeguards the GDPR requires (standard contractual clauses or an adequacy decision).',
    ],
  },
  {
    h: '5. For how long',
    p: [
      "A key's data and usage for as long as the key is active or the subscription runs, and then for as long as needed to handle any disputes and legal obligations. Technical request logs for a limited period tied to security and troubleshooting. My API sign-in links are valid for 15 minutes, sessions for 2 hours. Site and service statistics: visit recordings for 30 days, other browsing data and the API and MCP server statistics for the retention period of the analytics service (currently up to 7 years), unless you ask us to delete them. The saved position until you delete it. Webhooks and their delivery log like the key's data.",
    ],
  },
  {
    h: '6. Your rights',
    p: [
      'You can ask for access, rectification, erasure, restriction and portability, and object to processing based on legitimate interest, by writing to admin@flyitalyadsb.com. You can rotate or revoke your key from My API and opt out of statistics in point 7. You also have the right to lodge a complaint with the Italian data protection authority (garanteprivacy.it) or the authority of your country. You can delete the saved position at any time from My API or by asking the assistant.',
    ],
  },
  {
    id: 'cookies',
    h: '7. Cookies',
    p: [
      "Analytics: the PostHog cookie ph_…_posthog (1 year, shared by the site and the map), its __ph_opt_in_out_… cookie and the data stored in your browser for visit recordings.",
      "Needed: the My API session (sessionStorage, which your browser clears when you close the tab) and, if you opt out of statistics, the fia_consent cookie that remembers it for 13 months, on the site and on the map.",
      "We use no third-party advertising cookies.",
    ],
  },
];

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const linkify = (t: string) =>
  esc(t)
    .replace(/admin@flyitalyadsb\.com/g, '<a href="mailto:admin@flyitalyadsb.com" class="text-sky-400 no-underline hover:text-sky-300">admin@flyitalyadsb.com</a>')
    .replace(/garanteprivacy\.it/g, '<a href="https://www.garanteprivacy.it" rel="noopener" class="text-sky-400 no-underline hover:text-sky-300">garanteprivacy.it</a>')
    .replace(/My API/g, '<a href="/en/data/api/account/" class="text-sky-400 no-underline hover:text-sky-300">My API</a>')
    .replace(/point 7/g, '<a href="#cookies" class="text-sky-400 no-underline hover:text-sky-300">point 7</a>');
---

<Layout title="Privacy" description="FlyItalyADSB privacy notice: what data we process for API keys, subscriptions and feeders, why, for how long and your rights.">
  <div class="pt-24 pb-20 px-6 sm:px-12 lg:px-20 max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold text-slate-100 mb-3">Privacy notice</h1>
    <p class="text-sm text-slate-500 mb-10">Version of {VERSION}</p>
    {sections.map((s) => (
      <section id={s.id} class="mb-8 scroll-mt-20">
        <h2 class="text-lg font-semibold text-slate-100 mb-3">{s.h}</h2>
        {s.p.map((para) => <p class="text-sm text-slate-400 leading-relaxed mb-3" set:html={linkify(para)} />)}
      </section>
    ))}
    <StatsOptOut lang="en" />
  </div>
</Layout>
