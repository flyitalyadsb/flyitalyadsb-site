---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('docs', (e) => e.id.startsWith('en/'));
  return pages.map((entry) => ({ params: { slug: entry.id.slice(3) }, props: { entry, pages } }));
}

const { entry, pages } = Astro.props;
const { Content, headings } = await render(entry);
---
<DocsLayout lang="en" entry={entry} pages={pages} headings={headings} title={entry.data.title} description={entry.data.description}>
  <Content />
</DocsLayout>
