---
import Layout from '../../../layouts/Layout.astro';

// Periods covered by /v2/history. State verified on 2026-10-18: if it changes
// (days recovered, archives restored) update the Italian page too.
const coverage = [
  {
    period: '2022-04-10 – 2023-10-04',
    source: 'Old Virtual Radar Server',
    tone: 'yellow',
    detail:
      'Only the first and last point of each flight: the segment in between is an estimate, drawn dashed on the map. Every file has "version": "vrs-basestation-import/1". 529 days.',
  },
  {
    period: '2023-07-25 – 2024-06-27',
    source: 'readsb, previous server',
    tone: 'purple',
    detail:
      'Full track, with gaps: 206 days in all. September 2023 is missing; August 2023 and June 2024 are partial (15 and 5 days); February and April 2024 have 2 and 1 days. On the 26 days shared with the VRS period, the API returns the full track.',
  },
  {
    period: 'since 2026-08-17',
    source: 'readsb, current server',
    tone: 'green',
    detail: 'Full track, updated every day.',
  },
];

const toneColor = { purple: '#a78bfa', yellow: '#fbbf24', green: '#34d399' };
---

<Layout
  title="Historical archive"
  description="FlyItalyADSB's historical ADS-B archive since 2022: per-aircraft flight tracks, self-serve via REST API. Includes the weather32 research project on wind and temperature from Mode-S."
>
  <div class="pt-24 pb-20 px-6 sm:px-12 lg:px-20 max-w-4xl mx-auto">

    <div class="mb-14">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">
        <a href="/en/data/" class="text-slate-600 hover:text-slate-400 no-underline">Data</a>
        <span class="mx-2">/</span>
        <span class="text-slate-500">Archive</span>
      </p>
      <h1 class="text-4xl font-bold text-slate-100 mb-4">Historical archive</h1>
      <p class="text-slate-400 max-w-2xl leading-relaxed">
        FlyItalyADSB keeps the flight tracks collected by the network since 2022: position,
        altitude, speed and heading for every aircraft over time. All of it is available
        self-serve through the REST API, no access request needed.
      </p>
    </div>

    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-100 mb-6">Archive contents</h2>
      <div class="space-y-4">
        {[
          {
            tag: 'Globe history',
            color: 'purple',
            title: 'Per-aircraft position history',
            desc: "One JSON file per aircraft per day, in readsb's format: position, altitude, speed and heading through the day.",
            size: 'since 2022-04-10 · ~2.5 GB/day · all self-serve',
          },
          {
            tag: 'Weather research',
            color: 'green',
            title: 'Wind and temperature from Mode-S (weather32)',
            desc: 'The weather32 project derives upper-air wind and temperature from Mode-S BDS50/60 messages (True Air Speed, magnetic heading, IAS, Mach number), validated against ERA5/IASI. This is a research analysis, not an exportable archive: the raw data is not organized into a downloadable dataset on request.',
            size: null,
            link: { href: '/en/research/weather/', label: 'See the research results →' },
          },
        ].map(item => (
          <div class="p-6 rounded-xl border flex flex-col sm:flex-row gap-5" style="background:#0f1929;border-color:#1e3048">
            <div class="shrink-0">
              <span class="text-xs px-2.5 py-1 rounded font-mono font-semibold"
                    style={`background:${item.color === 'purple' ? '#8b5cf615' : item.color === 'yellow' ? '#f59e0b15' : '#10b98115'};color:${item.color === 'purple' ? '#a78bfa' : item.color === 'yellow' ? '#fbbf24' : '#34d399'};border:1px solid ${item.color === 'purple' ? '#8b5cf630' : item.color === 'yellow' ? '#f59e0b30' : '#10b98130'}`}>
                {item.tag}
              </span>
            </div>
            <div class="flex-1">
              <h3 class="font-semibold text-slate-100 mb-1">{item.title}</h3>
              <p class="text-sm text-slate-400 leading-relaxed mb-2">{item.desc}</p>
              {item.size && <span class="text-xs font-mono text-slate-600">{item.size}</span>}
              {item.link && (
                <a href={item.link.href} class="block text-xs font-mono text-sky-400 hover:text-sky-300 no-underline">{item.link.label}</a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Coverage -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-100 mb-2">Coverage</h2>
      <p class="text-sm text-slate-400 leading-relaxed mb-6 max-w-2xl">
        The history comes from three different sources, at different levels of detail.
        There is currently no data available between late June 2024 and mid-August 2026.
      </p>
      <div class="space-y-3">
        {coverage.map(c => (
          <div class="p-5 rounded-xl border flex flex-col sm:flex-row gap-3 sm:gap-6" style="background:#0f1929;border-color:#1e3048">
            <div class="sm:w-52 shrink-0">
              <div class="font-mono text-sm font-semibold" style={`color:${toneColor[c.tone]}`}>{c.period}</div>
              <div class="text-xs text-slate-500 mt-1">{c.source}</div>
            </div>
            <p class="flex-1 text-sm text-slate-400 leading-relaxed">{c.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Self-serve -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-100 mb-6">Accessing Globe history</h2>
      <div class="p-6 rounded-xl border" style="background:#0f1929;border-color:#1e3048">
        <table class="spec-table" style="margin-bottom:1rem">
          <tr>
            <td class="k">GET /v2/history/{'{icao}'}</td>
            <td class="d">Dates with available history for an aircraft, across the whole covered period.</td>
          </tr>
          <tr>
            <td class="k">GET /v2/history/{'{icao}'}/{'{date}'}</td>
            <td class="d">Track (position, altitude, speed, heading) for one aircraft on one day.</td>
          </tr>
        </table>
        <p class="text-sm text-slate-400 leading-relaxed mb-3">
          Same API key and plan limits as the rest of <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">/v2/*</code> —
          see the <a href="/en/data/api/#rest-api" class="text-sky-400 no-underline hover:text-sky-300">API documentation</a> for how to get a key.
        </p>
        <p class="text-sm text-slate-400 leading-relaxed">
          The <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">X-History-Source</code> header
          says where the day came from: <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">local</code> (the
          server's disk) or <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">r2</code> (the archive); for today, <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">live</code> (the track readsb is writing) or <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">store</code> (an aircraft readsb no longer receives: position, altitude and callsign only). The first
          request for an archived day may take a little longer.
        </p>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-2xl font-bold text-slate-100 mb-6">Larger extracts</h2>
      <div class="grid sm:grid-cols-2 gap-5">
        <div class="p-6 rounded-xl border" style="background:#0f1929;border-color:#38bdf830">
          <div class="flex items-center gap-2 mb-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="1.5">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="text-sm font-semibold text-slate-100">Research and special cases</span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed mb-4">
            For bulk extracts (many aircraft or long periods) or university/institutional
            research projects, write to us with a description of your project.
          </p>
          <a href="/en/contact/"
             class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium no-underline transition-all"
             style="background:#38bdf815;color:#7dd3fc;border:1px solid #38bdf830"
             onmouseover="this.style.background='#38bdf825'"
             onmouseout="this.style.background='#38bdf815'">
            Contact us →
          </a>
        </div>
        <div class="p-6 rounded-xl border" style="background:#0f1929;border-color:#1e3048">
          <div class="flex items-center gap-2 mb-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01" stroke-linecap="round"/>
            </svg>
            <span class="text-sm font-semibold text-slate-300">License</span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">
            Distributed data is licensed <strong class="text-slate-300">CC BY-SA 4.0</strong>.
            Attribution required; derivatives under the same license.
            MLAT military data: verify applicability before public use.
          </p>
        </div>
      </div>
    </section>

    <div class="rounded-xl p-5 border" style="background:#0a1320;border-color:#1e3048">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">How to cite</div>
      <code class="block text-xs font-mono p-3 rounded leading-relaxed" style="background:#0f1929;color:#94a3b8">
        FlyItalyADSB (flyitalyadsb.com) · ADS-B/MLAT data · License CC BY-SA 4.0<br />
        Infrastructure: Nesso Labs · nessolabs.it
      </code>
    </div>

  </div>
</Layout>
