---
import Layout from '../../../layouts/Layout.astro';
import ApiPlans from '../../../components/ApiPlans.astro';
import { PLANS, freeLimitsFrom } from '../../../data/plans';

const SITE = 'https://flyitalyadsb.com';

const faqs = [
  {
    q: 'Do I need an API key?',
    a: 'Yes, for both the REST API (api.flyitalyadsb.com/v2/*) and the MCP server (flyitalyadsb.com/mcp) — same key for both, passed in the X-Api-Key header. It\'s self-service and instant: just an email address: within seconds you get a link to see the key, no manual approval. The key is free; paid plans raise its limits without changing it.',
  },
  {
    q: 'Can I use the API commercially?',
    a: 'Yes, on every plan, free included, within that plan\'s limits. Above the free limits you need a paid plan (Starter from €9/month, Pro, Business): self-serve, cancel any time, the key you already have is upgraded in place. You can use it inside apps and devices you sell too (see below). An enterprise agreement is needed only to resell the data as an API or feed for other people\'s products, for an SLA or for volume beyond Business.',
  },
  {
    q: 'Can I put the key in an app or a device I sell? And use it from my server?',
    a: 'Yes. The key can be built into an app or device you distribute or sell, and your server can use it, caching included, to serve your product\'s users. Requests from all the devices and users count together towards that key\'s plan: for example 10 devices asking 12 times a minute, day and night, make 120 requests a minute and over 5 million a month, which is the Pro plan. Use one key per product and credit FlyItalyADSB and flyitalyadsb.com in the product (CC BY-SA 4.0). A key inside an app can be extracted: to keep it safe, use it only from your server. An enterprise agreement is needed only to resell the data as an API or feed for other people\'s products.',
  },
  {
    q: 'I run a receiver that feeds the network: do I get anything?',
    a: 'Yes: whoever feeds FlyItalyADSB gets the Pro plan limits on their Free keys at no cost (300 requests a minute, 10 million a month, worldwide radius), for non-commercial use. Turn it on in My API by opening the page from the same network as the receiver: we check that data arrives from there, as on the "Is my data arriving?" page. It lasts as long as the receiver feeds the network, with 3 days of grace if it stops.',
  },
  {
    q: 'How do payment and cancellation work?',
    a: 'A monthly subscription paid by card or wallet, prices before tax: your country\'s tax is added at checkout. Change plan or cancel any time from the links in your receipt; a cancellation takes effect at the end of the period and the key goes back to the Free plan. The data stays CC BY-SA 4.0: a plan pays for access and higher limits, not for a different licence.',
  },
  {
    q: 'Is there an SLA? How fast do you reply?',
    a: 'No plan includes an SLA or guaranteed response times, for the API or for email: FlyItalyADSB is a community and the paid plans only cover the cost of servers and bandwidth. The service is best effort and we reply as soon as we can. An SLA can only be agreed in an enterprise agreement.',
  },
  {
    q: 'Where does the data come from?',
    a: 'Almost all of it from the receivers of the FlyItalyADSB network, which send us their data first-hand, and from our own multilateration (MLAT). A small part comes from outside sources: ADSBHub and, for gliders and ultralights, the Open Glider Network (OGN). Aircraft seen only by those sources are about 1% of the total (measured on 19 October 2026): if one of them stops, the rest is unaffected.',
  },
  {
    q: 'How fresh are the positions?',
    a: 'The server rewrites the picture of every aircraft every 2 seconds and the API reloads it at most every 3. Each aircraft carries seen_pos, the seconds since its last position: in a measurement on 19 October 2026 half of the positions were under a second old and 9 in 10 under 7 seconds. Positions older than about 60 seconds are not returned.',
  },
  {
    q: 'Which fields does a response have? Is the flight route included?',
    a: 'Each aircraft is a record in readsb\'s aircraft.json format, the same as tar1090 and adsb.lol: ICAO hex, callsign (flight), registration (r) and type (t) for about 99% of aircraft, position, altitude, speed, track, squawk, category and the military, PIA and LADD flags. There is no route (departure and arrival airports) and no photos: for those you need another source.',
  },
  {
    q: 'Can I get every aircraft in an area in a single request?',
    a: 'Yes: /v2/lat/<lat>/lon/<lon>/dist/<km> returns every aircraft within the radius. The maximum radius depends on the plan: 500 km on Free, 1000 km on Starter, no limit on Pro and Business, which can ask for the whole world in one request. There is no single request for several aircraft by hex or registration: one request per aircraft, or one per radius.',
  },
  {
    q: 'How do I use the MCP server with Claude or ChatGPT?',
    a: 'Add https://flyitalyadsb.com/mcp as a custom connector (on claude.ai: Connectors → Add custom connector) and press Connect: you sign in with your email and a 6-digit code, no key to copy. In clients without OAuth, pass your key in the X-Api-Key header. Then just ask things like "what\'s flying over Fiumicino right now?" or "any military traffic over Rome?" and the agent will call the tools automatically.',
  },
  {
    q: 'What can the MCP server do that the map can\'t?',
    a: 'It returns structured data (JSON) instead of a web page: look up one aircraft by ICAO hex/callsign/registration, list every aircraft within a radius of any point on the planet with full records, and pull filtered lists of military, PIA (privacy), or LADD traffic.',
  },
  {
    q: 'Is the network limited to Italy?',
    a: 'No. FlyItalyADSB was born in Italy but is a global network with 3,200+ direct feeders worldwide — both the REST API and the MCP tools accept coordinates anywhere on the planet, not just Italy. Coverage follows the receivers: dense in Italy, much of Europe and North America, thinner in Asia, Africa and Oceania. For a given area, check the live map or try a request with a Free key.',
  },
  {
    q: 'How does this compare to other open ADS-B APIs (adsb.fi, airplanes.live, adsb.lol...)?',
    a: 'See the factual comparison at flyitalyadsb.com/en/data/comparison: rate limits, feeder requirements, and commercial-use terms for each, compared without value judgments.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Plans as schema.org offers — the same prices and limits the Plans section
// shows (src/data/plans.ts); structured data must match visible content.
const offersJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'FlyItalyADSB API',
  serviceType: 'Real-time ADS-B data API',
  provider: { '@type': 'Organization', name: 'Nesso Labs S.r.l.', vatID: 'IT04754860981', url: 'https://nessolabs.it' },
  url: `${SITE}/en/data/api/`,
  offers: PLANS.map((p) => ({
    '@type': 'Offer',
    name: p.id.charAt(0).toUpperCase() + p.id.slice(1),
    price: p.priceEur.toFixed(2),
    priceCurrency: 'EUR',
    url: `${SITE}/en/data/api/#piani`,
    ...(p.priceEur > 0 && {
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: p.priceEur.toFixed(2),
        priceCurrency: 'EUR',
        valueAddedTaxIncluded: false,
        billingDuration: 'P1M',
        unitText: 'month',
      },
    }),
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/en/` },
    { '@type': 'ListItem', position: 2, name: 'Data', item: `${SITE}/en/data/` },
    { '@type': 'ListItem', position: 3, name: 'API and AI agents', item: `${SITE}/en/data/api/` },
  ],
};

const mcpCallExample = `POST https://flyitalyadsb.com/mcp
Content-Type: application/json
X-Api-Key: <your-key>

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"aircraft_near","arguments":{"airport":"FCO","limit":5}}}`;
---

<Layout
  title="API, MCP and plans"
  description="FlyItalyADSB's REST API v2 and MCP server for developers and AI agents: a free key in seconds, commercial use included, and plans from €9/month for higher volume."
  jsonLd={[faqJsonLd, offersJsonLd, breadcrumbJsonLd]}
>
  <div class="pt-24 pb-20 px-6 sm:px-12 lg:px-20 max-w-5xl mx-auto">

    <div class="mb-10">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3">
        <a href="/en/data" class="text-slate-600 hover:text-slate-400 no-underline">Data</a>
        <span class="mx-2">/</span>
        <span class="text-slate-500">API and AI agents</span>
      </p>
      <h1 class="text-4xl font-bold text-slate-100 mb-4">API and AI agents</h1>
      <p class="text-slate-400 max-w-2xl leading-relaxed">
        Beyond the map, FlyItalyADSB's data can be queried programmatically: a REST API for
        developers, and an MCP (Model Context Protocol) server that lets AI agents like Claude or
        ChatGPT answer questions about live air traffic anywhere in the world.
      </p>
    </div>

    <nav class="page-index mb-10" aria-label="Page index">
      <a href="#piani"><span>01</span>Plans</a>
      <a href="#api-key"><span>02</span>Free key</a>
      <a href="#rest-api"><span>03</span>REST API</a>
      <a href="#mcp"><span>04</span>MCP server</a>
      <a href="#connect-claude"><span>05</span>Connect to Claude</a>
      <a href="#faq"><span>06</span>FAQ</a>
    </nav>

    <!-- At-a-glance readout — the reference specs a developer scans for
         first, before reading any prose. -->
    <div class="hud-panel rounded-lg overflow-hidden mb-14">
      <div class="hud-readout">
        <div><div class="k">rest base url</div><div class="v" style="font-size:13px">api.flyitalyadsb.com/v2</div></div>
        <div><div class="k">mcp endpoint</div><div class="v" style="font-size:13px">flyitalyadsb.com/mcp</div></div>
        <div><div class="k">auth</div><div class="v accent">X-Api-Key</div></div>
        <div><div class="k">plans</div><div class="v">free<span style="font-size:11px;color:#8391a7"> · from €9</span></div></div>
      </div>
    </div>

    <ApiPlans lang="en" />

    <!-- Auth signup -->
    <div id="api-key" class="rounded-xl p-8 border scroll-mt-24 mb-14" style="background:#0a1320;border-color:#1e3048">
      <h3 class="font-semibold text-slate-100 mb-2">Get an API key</h3>
      <p class="text-sm text-slate-400 leading-relaxed mb-6">
        The REST API and the MCP server share the same key, passed in the <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">X-Api-Key</code> header.
        Instant and free: enter an email and you get a link that shows the key once (the key itself never travels by email).
        Requesting again with the same email keeps the old key working until you open the new link, then
        the new key replaces it (also how to recover a lost key).
        Already have a key? See its plan and usage, or rotate it, from
        <a href="/en/data/api/account/" class="text-sky-400 no-underline hover:text-sky-300">My API</a>.
      </p>
      <form id="key-form" class="space-y-3" novalidate>
        <div class="grid sm:grid-cols-2 gap-3">
          <div>
            <label for="key-email" class="block text-xs text-slate-400 mb-1.5">Email</label>
            <input type="email" id="key-email" name="email" required autocomplete="email" aria-describedby="key-status" placeholder="you@example.com"
                 class="px-3 py-2.5 rounded-lg text-sm w-full"
                 style="background:#111e30;color:#e2e8f0;border:1px solid var(--color-input-border)" />
          </div>
          <div>
            <label for="key-name" class="block text-xs text-slate-400 mb-1.5">Name or project <span class="text-slate-500">(optional)</span></label>
            <input type="text" id="key-name" name="name" maxlength="200"
                 class="px-3 py-2.5 rounded-lg text-sm w-full"
                 style="background:#111e30;color:#e2e8f0;border:1px solid var(--color-input-border)" />
          </div>
        </div>
        <div>
          <label for="key-use-case" class="block text-xs text-slate-400 mb-1.5">What will you use it for? <span class="text-slate-500">(optional)</span></label>
          <input type="text" id="key-use-case" name="use_case" maxlength="500"
                 class="px-3 py-2.5 rounded-lg text-sm w-full"
                 style="background:#111e30;color:#e2e8f0;border:1px solid var(--color-input-border)" />
        </div>
        <div class="flex items-center gap-4">
          <button type="submit" id="key-submit"
                  class="px-5 py-2.5 rounded-lg font-medium text-sm transition-all"
                  style="background:#38bdf815;color:#7dd3fc;border:1px solid #38bdf830"
                  onmouseover="this.style.background='#38bdf825'"
                  onmouseout="this.style.background='#38bdf815'">
            Email me the link →
          </button>
          <p id="key-status" class="text-sm" role="status"></p>
        </div>
        <p class="text-xs text-slate-500">If this email already has a free key, it keeps working until you open the link: from then on the new one replaces it.</p>
      </form>
    </div>

    <!-- REST API -->
    <section id="rest-api" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">REST API</h2>
      <p class="text-slate-400 text-sm leading-relaxed mb-6">
        Base URL <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">https://api.flyitalyadsb.com/v2</code>,
        JSON responses, authenticated via the <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">X-Api-Key</code> header.
      </p>
      <table class="spec-table">
        {[
          { path: '/icao/{hex}', desc: 'One aircraft by 24-bit ICAO address.' },
          { path: '/callsign/{callsign}', desc: 'One aircraft by callsign/flight number.' },
          { path: '/reg/{reg}', desc: 'One aircraft by tail registration.' },
          { path: '/lat/{lat}/lon/{lon}/dist/{km}', desc: 'Every aircraft within a radius of a point, full records — works anywhere in the world, not just Italy.' },
          { path: '/mil', desc: 'Currently tracked military traffic.' },
          { path: '/pia', desc: 'Aircraft with a Privacy ICAO Address.' },
          { path: '/ladd', desc: 'Aircraft in the FAA Limiting Aircraft Data Displayed program.' },
          { path: '/history/{icao}', desc: 'Dates with available history for an aircraft — see the historical archive.' },
          { path: '/history/{icao}/{date}', desc: 'Full track (position, altitude, speed, heading) for one aircraft on one day.' },
        ].map((e) => (
          <tr>
            <td class="k">GET {e.path}</td>
            <td class="d">{e.desc}</td>
          </tr>
        ))}
      </table>
      <p class="text-xs text-slate-500 mt-4">
        Free plan: 30 requests/minute per key, 300,000 a month and a radius up to 500 km from {freeLimitsFrom('en')} (until then 100 requests/minute per IP); paid plans have their own per-key limits (see <a href="#piani" class="text-sky-400 no-underline hover:text-sky-300">Plans</a>). Requests without <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">X-Api-Key</code> are rejected at the edge.
      </p>
      <p class="text-xs text-slate-500 mt-2">
        Commercial use is allowed on every plan within its limits, inside apps and devices you sell too. Reselling the data as an API or feed
        for others, an SLA or volume beyond Business need an enterprise agreement — <a href="/en/contact" class="text-sky-400 no-underline hover:text-sky-300">contact us</a>.
      </p>
    </section>

    <!-- MCP -->
    <section id="mcp" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">MCP server for AI agents</h2>
      <p class="text-slate-400 text-sm leading-relaxed mb-6">
        The <a href="https://modelcontextprotocol.io" target="_blank" rel="noopener" class="text-sky-400 no-underline">Model Context Protocol</a>
        is the standard assistants like Claude or ChatGPT use to call external tools. Our server exposes
        four read-only tools at
        <code class="text-xs px-1.5 py-0.5 rounded" style="background:#111e30;color:#7dd3fc">https://flyitalyadsb.com/mcp</code>:
      </p>
      <table class="spec-table" style="margin-bottom:1.5rem">
        {[
          { name: 'find_aircraft', desc: 'Look up one aircraft by ICAO hex, callsign, or registration.' },
          { name: 'aircraft_near', desc: 'Every aircraft within a radius of a point (or an Italian airport by name), full records — the most useful one.' },
          { name: 'special_traffic', desc: 'Currently tracked military, PIA (privacy), or LADD traffic.' },
          { name: 'aircraft_history', desc: "One aircraft's historical track for a day, or the dates available — self-serve, since 2022 (see the archive for coverage)." },
        ].map((t) => (
          <tr>
            <td class="k" style="color:#a78bfa">{t.name}</td>
            <td class="d">{t.desc}</td>
          </tr>
        ))}
      </table>
      <h3 id="connect-claude" class="text-lg font-semibold text-slate-100 mb-3 mt-8 scroll-mt-24">How to connect it to Claude</h3>
      <ol class="space-y-2 mb-6 text-sm text-slate-400 list-decimal list-inside marker:text-slate-600">
        <li>On <a href="https://claude.ai/customize/connectors" target="_blank" rel="noopener" class="text-sky-400 no-underline">claude.ai</a>, open <strong class="text-slate-300">Customize → Connectors</strong> and click <strong class="text-slate-300">"Add custom connector"</strong>.</li>
        <li>Give it a name, e.g. "FlyItalyADSB", and paste the URL <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">https://flyitalyadsb.com/mcp</code>.</li>
        <li>For authentication leave <strong class="text-slate-300">"Sign in now"</strong> (Claude detects it) and for the OAuth client <strong class="text-slate-300">"Use Claude's published identity"</strong>, then add the connector.</li>
        <li>Press <strong class="text-slate-300">Connect</strong>: a FlyItalyADSB page opens. Type your email, then the 6-digit code you receive, and press <strong class="text-slate-300">Allow</strong>. If you don't have an API key yet, we create a free one right then.</li>
        <li>Try asking Claude something like <em>"what aircraft are near Rome Fiumicino right now?"</em></li>
      </ol>
      <p class="text-xs text-slate-500 leading-relaxed mb-6">
        You can disconnect it at any time from <a href="/en/data/api/account/" class="text-sky-400 no-underline">My API</a>.
        From <a href="https://code.claude.com/docs/en/mcp-quickstart" target="_blank" rel="noopener" class="text-sky-400 no-underline">Claude Code</a> or a client without OAuth it also works with the key:
        <code class="text-xs px-1 rounded" style="background:#111e30;color:#7dd3fc">claude mcp add --transport http flyitalyadsb https://flyitalyadsb.com/mcp --header "X-Api-Key: ‹your-key›"</code>
      </p>

      <!-- Illustrative mockup, not a literal screenshot: Claude's actual UI can
           differ slightly and would go stale fast if copied pixel-for-pixel. -->
      <div class="rounded-xl border overflow-hidden mb-2" style="border-color:#1e3048">
        <div class="px-4 py-2 flex items-center gap-2" style="background:#111e30;border-bottom:1px solid #1e3048">
          <span class="w-2 h-2 rounded-full" style="background:#f87171"></span>
          <span class="w-2 h-2 rounded-full" style="background:#fbbf24"></span>
          <span class="w-2 h-2 rounded-full" style="background:#34d399"></span>
          <span class="ml-2 text-xs font-semibold text-slate-500">claude.ai — Customize → Connectors</span>
        </div>
        <div class="p-5 space-y-3" style="background:#0a1320">
          <div>
            <div class="text-xs text-slate-500 mb-1">Name</div>
            <div class="px-3 py-2 rounded text-sm text-slate-300" style="background:#111e30;border:1px solid #1e3048">FlyItalyADSB</div>
          </div>
          <div>
            <div class="text-xs text-slate-500 mb-1">Remote MCP server URL</div>
            <div class="px-3 py-2 rounded text-sm font-mono" style="background:#111e30;border:1px solid #1e3048;color:#7dd3fc">https://flyitalyadsb.com/mcp</div>
          </div>
          <div>
            <div class="text-xs text-slate-500 mb-1">Authentication</div>
            <div class="px-3 py-2 rounded text-sm text-slate-300" style="background:#111e30;border:1px solid #1e3048">Sign in now &middot; Use Claude's published identity</div>
          </div>
        </div>
      </div>
      <p class="text-xs text-slate-600 mb-8">Illustrative mockup — your client's actual UI may look slightly different.</p>

      <h3 class="text-lg font-semibold text-slate-100 mb-3">For other MCP clients</h3>
      <p class="text-slate-400 text-sm leading-relaxed mb-3">
        Other MCP clients with OAuth connect the same way, with Connect. From your own code, or a client without
        OAuth, use the key in the X-Api-Key header, including a raw call:
      </p>
      <pre class="p-4 rounded-lg text-xs overflow-auto leading-relaxed" style="background:#0a1320;color:#94a3b8;border:1px solid #1e3048"><code>{mcpCallExample}</code></pre>
    </section>

    <!-- FAQ — same content as faqJsonLd above; that structured data must
         match what's actually visible on the page, and until now it had no
         visible counterpart at all. -->
    <section id="faq" class="mb-14 scroll-mt-24">
      <h2 class="text-2xl font-bold text-slate-100 mb-6">Frequently asked questions</h2>
      <div class="divide-y" style="border-color:#1e3048;border-top:1px solid #1e3048;border-bottom:1px solid #1e3048">
        {faqs.map((f) => (
          <details class="group" style="border-color:#1e3048">
            <summary class="py-4 cursor-pointer list-none flex items-center justify-between gap-4 text-sm font-semibold text-slate-200 hover:text-white">
              {f.q}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" class="shrink-0 transition-transform group-open:rotate-45">
                <path d="M12 5v14m-7-7h14" stroke-linecap="round"/>
              </svg>
            </summary>
            <p class="text-sm text-slate-400 leading-relaxed pb-4 pr-8">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

  </div>

  <script>
    import { identify, track } from '../../../lib/analytics';

    const form = document.getElementById('key-form') as HTMLFormElement;
    const submitBtn = document.getElementById('key-submit') as HTMLButtonElement;
    const status = document.getElementById('key-status') as HTMLParagraphElement;

    function setStatus(text: string, color: string) {
      status.textContent = text;
      status.style.color = color;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('key-email') as HTMLInputElement).value.trim();
      const name = (document.getElementById('key-name') as HTMLInputElement).value.trim();
      const useCase = (document.getElementById('key-use-case') as HTMLInputElement).value.trim();

      submitBtn.disabled = true;
      setStatus('Sending…', '#94a3b8');

      try {
        const res = await fetch('https://api.flyitalyadsb.com/v2/keys', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, name: name || undefined, use_case: useCase || undefined, lang: 'en' }),
        });
        if (res.status === 202) identify(email);
        track('api_key_requested', { status: res.status });
        if (res.status === 202) {
          setStatus('Done — check your email for the link to see your key.', '#34d399');
          form.reset();
        } else if (res.status === 429) {
          setStatus('You already requested a key recently — try again in a few minutes.', '#fbbf24');
        } else if (res.status === 409) {
          setStatus('A request for this email is already in progress — try again in a moment.', '#fbbf24');
        } else if (res.status === 413) {
          setStatus('Name or use case is too long — shorten it and try again.', '#f87171');
        } else {
          const body = await res.json().catch(() => null);
          setStatus(body?.error || 'Something went wrong, please try again.', '#f87171');
        }
      } catch {
        setStatus('Could not reach the service, try again shortly.', '#f87171');
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</Layout>
