---
// Landing page after a completed Stripe Checkout (success_url set by
// nesso-infra public-api/billing.py: /dati/api/grazie/?plan=<plan>). The page
// can't know whether the webhook has already run, so it says what happens
// next instead of claiming the plan is live. A brand-new key is never in an
// email (2026-10-19): the email brings a one-time link to /dati/api/chiave/.
// One host for every plan (api.flyitalyadsb.com), so no host choice here.
import { PLANS } from '../data/plans';

interface Props {
  lang: 'it' | 'en';
}
const { lang } = Astro.props;
const it = lang === 'it';
const nf = new Intl.NumberFormat(it ? 'it-IT' : 'en-US');
const paid = PLANS.filter((p) => p.priceEur > 0).map((p) => ({
  id: p.id,
  name: p.id.charAt(0).toUpperCase() + p.id.slice(1),
  limits: it
    ? `${nf.format(p.perMin)} richieste/min per chiave · ${nf.format(p.perMonth)} richieste/mese · ${p.maxRadiusKm ? `raggio fino a ${nf.format(p.maxRadiusKm)} km` : 'raggio mondiale'}`
    : `${nf.format(p.perMin)} requests/min per key · ${nf.format(p.perMonth)} requests/month · ${p.maxRadiusKm ? `radius up to ${nf.format(p.maxRadiusKm)} km` : 'worldwide radius'}`,
}));

const t = it
  ? {
      kicker: 'Pagamento completato',
      title: 'Grazie!',
      lead: (plan: string) => `Il tuo piano ${plan} sta per attivarsi.`,
      fallbackPlan: 'a pagamento',
      tryTitle: 'Prova la chiave',
      tryText: 'Appena ti arriva la conferma, una chiamata basta per vedere il nuovo piano nella risposta (header X-FIA-Plan):',
      tryCmd: 'curl -i -H "x-api-key: LA_TUA_CHIAVE" https://api.flyitalyadsb.com/v2/mil',
      steps: [
        ['La chiave', "Entro pochi secondi la API key della tua email passa al nuovo piano: non devi cambiarla. Se non ne avevi ancora una, ti arriva un'email con un link per vederla: funziona una volta sola e vale 7 giorni."],
        ['Ricevuta e abbonamento', "La ricevuta del pagamento ti arriva in un'email separata. Per cambiare piano, aggiornare il metodo di pagamento o disdire quando vuoi, usa La mia API."],
      ],
      noMail: "Nessuna email entro qualche minuto? Controlla lo spam, poi scrivici: rispondiamo entro un giorno lavorativo.",
      docs: 'Documentazione API',
      account: 'La mia API',
      accountHref: '/dati/api/account/',
      contact: 'Contattaci',
      docsHref: '/dati/api/',
      contactHref: '/contatti',
    }
  : {
      kicker: 'Payment complete',
      title: 'Thank you!',
      lead: (plan: string) => `Your ${plan} plan is about to go live.`,
      fallbackPlan: 'paid',
      tryTitle: 'Try your key',
      tryText: 'As soon as the confirmation arrives, one call shows the new plan in the response (X-FIA-Plan header):',
      tryCmd: 'curl -i -H "x-api-key: YOUR_KEY" https://api.flyitalyadsb.com/v2/mil',
      steps: [
        ['Your key', "Within seconds the API key of your email moves to the new plan: no need to change it. If you didn't have one yet, you'll get an email with a link to see it: it works once and for 7 days."],
        ['Receipt and subscription', "You'll receive the payment receipt in a separate email. To change plan, update your payment method or cancel any time, use My API."],
      ],
      noMail: "No email within a few minutes? Check your spam folder, then write to us: we answer within one business day.",
      docs: 'API documentation',
      account: 'My API',
      accountHref: '/en/data/api/account/',
      contact: 'Contact us',
      docsHref: '/en/data/api/',
      contactHref: '/en/contact',
    };
---

<div class="pt-24 pb-20 px-6 sm:px-12 lg:px-20 max-w-3xl mx-auto" id="thanks"
     data-plans={JSON.stringify(paid)} data-fallback={t.fallbackPlan} data-lead={t.lead('{plan}')}>
  <p class="text-xs font-semibold uppercase tracking-widest mb-3" style="color:#34d399">{t.kicker}</p>
  <h1 class="text-4xl font-bold text-slate-100 mb-4">{t.title}</h1>
  <p id="thanks-lead" class="text-lg text-slate-300 mb-2">{t.lead(t.fallbackPlan)}</p>
  <p id="thanks-limits" class="text-sm text-slate-500 font-mono mb-10"></p>

  <ol class="space-y-5 mb-10">
    {t.steps.map(([h, p], i) => (
      <li class="flex gap-4">
        <span class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold"
              style="background:#34d39915;color:#6ee7b7;border:1px solid #34d39940">{i + 1}</span>
        <div>
          <div class="text-sm font-semibold text-slate-100 mb-1">{h}</div>
          <p class="text-sm text-slate-400 leading-relaxed">{p}</p>
        </div>
      </li>
    ))}
  </ol>

  <div class="rounded-lg p-4 mb-8 border" style="background:#0a1320;border-color:#1e3048">
    <div class="text-sm font-semibold text-slate-100 mb-1">{t.tryTitle}</div>
    <p class="text-sm text-slate-400 mb-3">{t.tryText}</p>
    <pre class="text-xs overflow-auto p-3 rounded" style="background:#111e30;color:#7dd3fc"><code>{t.tryCmd}</code></pre>
  </div>

  <p class="text-xs text-slate-500 mb-8">{t.noMail}</p>
  <div class="flex flex-wrap gap-3">
    <a href={t.accountHref} class="px-5 py-2.5 rounded-lg text-sm font-medium no-underline"
       style="background:#38bdf815;color:#7dd3fc;border:1px solid #38bdf830">{t.account} →</a>
    <a href={t.docsHref} class="px-5 py-2.5 rounded-lg text-sm no-underline"
       style="background:#111e30;color:#cbd5e1;border:1px solid #1e3048">{t.docs}</a>
    <a href={t.contactHref} class="px-5 py-2.5 rounded-lg text-sm no-underline"
       style="background:#111e30;color:#cbd5e1;border:1px solid #1e3048">{t.contact}</a>
  </div>
</div>

<script>
  const box = document.getElementById('thanks') as HTMLElement;
  const plans = JSON.parse(box.dataset.plans || '[]') as { id: string; name: string; limits: string }[];
  const id = new URLSearchParams(location.search).get('plan');
  const plan = plans.find((p) => p.id === id);
  if (plan) {
    (document.getElementById('thanks-lead') as HTMLElement).textContent =
      (box.dataset.lead || '').replace('{plan}', plan.name);
    (document.getElementById('thanks-limits') as HTMLElement).textContent = plan.limits;
  }
</script>
