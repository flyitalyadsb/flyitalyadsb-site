---
// Consent banner for PostHog (src/lib/analytics.ts). Shown until the visitor
// chooses, and again from "Preferenze cookie" in the footer or after six
// months. Accept and decline are the same size and weight, and closing it
// counts as declining (Garante, linee guida cookie 2021): no cookie wall, the
// site works the same either way.
const isEn = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');

const t = isEn
  ? {
      label: 'Cookie preferences',
      text: 'We use PostHog analytics cookies to improve the site.',
      privacy: 'Privacy notice',
      privacyHref: '/en/privacy/',
      accept: 'Accept',
      decline: 'Decline',
      close: 'Close (declines)',
    }
  : {
      label: 'Preferenze cookie',
      text: 'Usiamo i cookie di statistica di PostHog per migliorare il sito.',
      privacy: 'Informativa privacy',
      privacyHref: '/privacy/',
      accept: 'Accetto',
      decline: 'Rifiuto',
      close: 'Chiudi (rifiuta)',
    };

const button = 'flex-1 sm:flex-none px-5 py-2 rounded-lg text-sm font-medium whitespace-nowrap';
const buttonStyle = 'background:#111e30;color:#e2e8f0;border:1px solid #38bdf850';
---

<section id="cookie-banner" role="region" aria-label={t.label} hidden
         class="fixed bottom-0 left-0 right-0 z-[55] p-4">
  <div class="relative max-w-3xl mx-auto rounded-xl border p-5 pr-10 shadow-2xl"
       style="background:#0a1320;border-color:#1e3048">
    <button type="button" data-consent="denied" aria-label={t.close}
            class="absolute top-2 right-2 p-2 rounded text-slate-400 hover:text-slate-100 hover:bg-white/5">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>
    <p class="text-sm text-slate-300 leading-relaxed">
      {t.text} <a href={t.privacyHref} class="text-sky-400 no-underline hover:text-sky-300">{t.privacy}</a>
    </p>
    <div class="mt-4 flex gap-3">
      <button type="button" data-consent="denied" class={button} style={buttonStyle}>{t.decline}</button>
      <button type="button" data-consent="granted" class={button} style={buttonStyle}>{t.accept}</button>
    </div>
  </div>
</section>

<script>
  import { consent, setConsent, startAnalytics, type Choice } from '../lib/analytics';

  const banner = document.getElementById('cookie-banner') as HTMLElement;
  const show = () => { banner.hidden = false; };

  banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
    b.addEventListener('click', () => {
      setConsent(b.dataset.consent as Choice);
      banner.hidden = true;
    }));
  document.querySelectorAll('[data-cookie-prefs]').forEach((a) =>
    a.addEventListener('click', (e) => { e.preventDefault(); show(); }));

  if (consent() === null) show();
  startAnalytics();
</script>
