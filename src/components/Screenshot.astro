---
// One screenshot as AVIF with a WebP fallback, at the widths it was exported
// in (public/img/<dir>/<name>-<width>.avif|webp). width/height are the
// largest file's, so the browser reserves the right box before it loads.
// Lazy unless `eager` (only the hero, the likely LCP element).
interface Props {
  /** Path without width and extension, e.g. /img/mcp/chat-desktop-it */
  src: string;
  /** Exported widths, largest first. */
  widths: number[];
  width: number;
  height: number;
  alt: string;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { src, widths, width, height, alt, sizes, eager = false, class: cls } = Astro.props;
const set = (ext: string) => widths.map((w) => `${src}-${w}.${ext} ${w}w`).join(', ');
---
<picture>
  <source type="image/avif" srcset={set('avif')} sizes={sizes} />
  <source type="image/webp" srcset={set('webp')} sizes={sizes} />
  <img
    src={`${src}-${widths[0]}.webp`}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'auto' : 'async'}
    fetchpriority={eager ? 'high' : undefined}
    class={cls}
  />
</picture>
