      nearAlt: 'The map with 6 aircraft within 30 km of the saved position, in Pisa.',

      limitsH: 'Limits and requests',
      limitsLede: 'Every time the assistant calls a tool it makes one API request, which counts on your key’s plan like a direct call. One question can cost more than one if the assistant uses several tools. The maximum radius is the plan’s too.',
      limitsCols: ['Plan', 'Per minute', 'Per month', 'Maximum radius'],
      limitsCaption: 'Requests per key and maximum radius of each plan',
      worldwide: 'worldwide',
      free: 'free',
      perMonth: (eur: number) => `€${eur}/month`,
      limitsNote: FREE_LIMITS_FROM ? `Free-plan limits apply from ${freeLimitsFrom('en')}; until then a Free key stays at 100 requests/minute per IP.` : '',
      limitsLink: 'Plans, prices and commercial use',

      privacyH: 'Privacy',
      privacy: [
        ['Your position', 'We don’t receive your device’s position. If you save one, we round it to about 1 km before storing it: one per account, and you can delete it any time.'],
        ['Aircraft, not people', 'No answer contains the names of owners or operators, and we don’t know who is on board.'],
        ['The map', 'It loads only OpenStreetMap tiles: it asks for no permissions and doesn’t use your location.'],
        ['PIA and LADD', 'Aircraft with a privacy address or in the FAA LADD program are flagged, not hidden, as everywhere on the network. No photo links for them.'],
        ['The connection', 'Disconnect it from <a href="/en/data/api/account/">My API</a>, under “Connected assistants”. Your key doesn’t change.'],
      ],
      privacyLink: 'Full privacy policy',

      faqH: 'Frequently asked questions',
      faqAll: 'All frequently asked questions',
      docsH: 'Documentation',
      docs: [
        { href: '/en/data/api/docs/mcp/', label: 'MCP server', desc: 'the tools, “near me”, clients and limits, in the documentation' },
        { href: '/en/data/api/', label: 'REST API', desc: 'the same data from your own code: endpoints, plans and a free key' },
        { href: '/auth.md', label: 'auth.md', desc: 'how an agent gets and uses a credential' },
        { href: '/.well-known/mcp/server-card.json', label: 'Server card', desc: 'the server described in JSON, for machines' },
      ],
    };

const codeCmd = `claude mcp add --transport http flyitalyadsb ${MCP_URL} \\\n  --header "X-Api-Key: ${T.codeKey}"`;
const rawCall = `POST ${MCP_URL}
Content-Type: application/json
Accept: application/json, text/event-stream
X-Api-Key: ${T.rawKey}

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"aircraft_near","arguments":{"airport":"FCO","radiusKm":25}}}`;

const faqs = faqsFor((f) => f.cat === 'mcp');

// ------------------------------------------------------------------ JSON-LD
const pageUrl = `${SITE}${href.self}`;
const tools = T.groups.flatMap((g) => g.tools);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: it ? 'Server MCP di FlyItalyADSB' : 'FlyItalyADSB MCP server',
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'Model Context Protocol server',
    operatingSystem: 'Any',
    url: pageUrl,
    installUrl: MCP_URL,
    description: T.description,
    inLanguage: it ? 'it-IT' : 'en-US',
    isAccessibleForFree: true,
    featureList: tools.map((t) => `${t.name}: ${t.desc}`),
    screenshot: [`${SITE}${img('chat-desktop')}-1440.webp`, `${SITE}${img('fullscreen-light')}-1920.webp`, `${SITE}${img('chat-mobile')}-720.webp`],
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR', url: `${SITE}${href.plans}` },
    provider: { '@type': 'Organization', name: 'Nesso Labs S.r.l.', vatID: 'IT04754860981', url: 'https://nessolabs.it' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f[lang].q, acceptedAnswer: { '@type': 'Answer', text: f[lang].a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}${it ? '/' : '/en/'}` },
      { '@type': 'ListItem', position: 2, name: it ? 'Dati' : 'Data', item: `${SITE}${href.data}` },
      { '@type': 'ListItem', position: 3, name: T.crumb, item: pageUrl },
    ],
  },
];

const idxIds = [id.connect, id.tools, id.map, id.near, id.limits, id.privacy, id.faq, id.docs];
const planName = (p: string) => p.charAt(0).toUpperCase() + p.slice(1);
---

<Layout title={T.title} description={T.description} image={`/img/mcp/og-${lang}.jpg`} jsonLd={jsonLd}>
  <div class="mcp pt-24 pb-20 px-4 sm:px-8 lg:px-12 max-w-6xl mx-auto">

    <!-- Hero: the copy, and the thing itself: a question and the map it gets. -->
    <section class="hero grid lg:grid-cols-[minmax(0,4fr)_minmax(0,6fr)] gap-10 lg:gap-14 items-center mb-14">
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-4">
          <a href={href.data} class="text-slate-600 hover:text-slate-400 no-underline">{it ? 'Dati' : 'Data'}</a>
          <span class="mx-2">/</span>
          <span class="text-slate-500">{T.crumb}</span>
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-[1.08] mb-5 [text-wrap:balance]" style="color:#f0f9ff">{T.h1}</h1>
        <p class="text-slate-300 text-lg leading-relaxed mb-8 max-w-xl">{T.lede}</p>
        <div class="flex flex-wrap items-center gap-3 mb-5">
          <a href={`#${id.connect}`} class="btn-primary">{T.ctaConnect}</a>
          <button type="button" class="copy-url" data-copy={MCP_URL} data-done={T.copied} title={T.copyUrl}>
            <span class="sr-only">{T.copyUrl}: </span><span class="font-mono">flyitalyadsb.com/mcp</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          </button>
          <span class="copy-status text-sm" role="status" aria-live="polite"></span>
        </div>
        <p class="text-sm text-slate-500 max-w-md leading-relaxed">{T.fine}</p>
      </div>

      <figure class="chat">
        <p class="bubble bubble-lg chat-in" style="--d:0ms">{T.ask}</p>
        <p class="call chat-in" style="--d:160ms" aria-hidden="true">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z" stroke-linejoin="round"/></svg>
          <span><b>aircraft_near</b>(airport: "FCO", radiusKm: 50)</span>
        </p>
        <div class="widget chat-rise" style="--d:260ms">
          <picture>
            <source media="(max-width: 559px)" type="image/avif" srcset={`${img('chat-mobile')}-720.avif 720w`} sizes="calc(100vw - 58px)" width="720" height="974" />
            <source media="(max-width: 559px)" type="image/webp" srcset={`${img('chat-mobile')}-720.webp 720w`} sizes="calc(100vw - 58px)" width="720" height="974" />
            <source type="image/avif" srcset={`${img('chat-desktop')}-1440.avif 1440w, ${img('chat-desktop')}-720.avif 720w`} sizes="(min-width: 1152px) 620px, (min-width: 1024px) 54vw, calc(100vw - 96px)" />
            <source type="image/webp" srcset={`${img('chat-desktop')}-1440.webp 1440w, ${img('chat-desktop')}-720.webp 720w`} sizes="(min-width: 1152px) 620px, (min-width: 1024px) 54vw, calc(100vw - 96px)" />
            <img src={`${img('chat-desktop')}-1440.webp`} width="1440" height="1074" alt={T.heroAlt} fetchpriority="high" class="hero-img" />
          </picture>
        </div>
        <p class="reply chat-in" style="--d:520ms">{T.reply}</p>
        <figcaption class="chat-note">{T.heroNote}</figcaption>
      </figure>
    </section>

    <nav class="page-index mb-16" aria-label={T.index}>
      {T.idx.map((label, i) => <a href={`#${idxIds[i]}`}>{label}</a>)}
    </nav>

    <!-- Connect -->
    <section id={id.connect} class="scroll-mt-24 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-3">{T.connectH}</h2>
      <p class="text-slate-400 leading-relaxed max-w-2xl mb-8">{T.connectLede}</p>

      <div class="grid lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] gap-8 lg:gap-12 items-start">
        <div class="tabs" data-tabs>
          <div class="tablist" role="tablist" aria-label={T.tabsLabel} hidden>
            {T.tabs.map((label, i) => (
              <button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{label}</button>
            ))}
          </div>

          <div class="panel" role="tabpanel" id="panel-0" aria-labelledby="tab-0">
            <h3 class="panel-h">{T.tabs[0]}</h3>
            <ol class="steps">
              <li><span set:html={T.claude[0]} /></li>
              <li><span set:html={T.claude[1]} />
                <button type="button" class="copy-inline" data-copy={MCP_URL} data-done={T.copyDone}><code>{MCP_URL}</code><span class="copy-label">{T.copy}</span></button>
              </li>
              <li><span set:html={T.claude[2]} /></li>
              <li><span set:html={T.claude[3]} /> <span class="bubble">{T.claudeAsk}</span></li>
            </ol>
            <p class="panel-note">{T.claudeNote}</p>
          </div>

          <div class="panel" role="tabpanel" id="panel-1" aria-labelledby="tab-1">
            <h3 class="panel-h">{T.tabs[1]}</h3>
            <ol class="steps">
              <li><span set:html={T.chatgpt[0]} /></li>
              <li><span set:html={T.chatgpt[1]} />
                <button type="button" class="copy-inline" data-copy={MCP_URL} data-done={T.copyDone}><code>{MCP_URL}</code><span class="copy-label">{T.copy}</span></button>
              </li>
              <li><span set:html={T.chatgpt[2]} /></li>
              <li><span set:html={T.chatgpt[3]} /> <span class="bubble">{T.chatgptAsk}</span></li>
            </ol>
            <p class="panel-note">{T.chatgptNote}</p>
          </div>

          <div class="panel" role="tabpanel" id="panel-2" aria-labelledby="tab-2">
            <h3 class="panel-h">{T.tabs[2]}</h3>
            <p class="text-slate-300 text-[15px] leading-relaxed mb-3" set:html={T.codeIntro} />
            <div class="code">
              <pre><code>{codeCmd}</code></pre>
              <button type="button" class="code-copy" data-copy={codeCmd.replace(' \\\n  ', ' ')} data-done={T.copyDone}>{T.copy}</button>
            </div>
            <ul class="others">
              {T.others.map((o) => <li set:html={o} />)}
            </ul>
            <details class="raw">
              <summary>{T.rawSummary}</summary>
              <pre><code>{rawCall}</code></pre>
            </details>
          </div>
        </div>

        <figure class="signin">
          <Screenshot src={img('sign-in')} widths={[776]} width={776} height={760} alt={T.signinAlt}
            sizes="(min-width: 1024px) 360px, min(388px, calc(100vw - 32px))" class="shot shot-signin" />
          <figcaption class="cap" set:html={T.signinCap} />
        </figure>
      </div>
    </section>

    <!-- Tools -->
    <section id={id.tools} class="scroll-mt-24 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-3">{T.toolsH}</h2>
      <p class="text-slate-400 leading-relaxed max-w-2xl mb-8">{T.toolsLede}</p>
      <div class="toolgroups">
        {T.groups.map((g) => (
          <div class="toolgroup">
            <h3 class="group-name">{g.name}</h3>
            <ul class="toollist">
              {g.tools.map((t) => (
                <li class="tool">
                  <div class="tool-head">
                    <code class="tool-name">{t.name}</code>
                    {t.map && (
                      <span class="tag-map">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14" stroke-linejoin="round"/></svg>
                        {T.mapTag}
                      </span>
                    )}
                  </div>
                  <p class="tool-desc">{t.desc}</p>
                  <p class="bubble">{t.ask}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- The map in the chat -->
    <section id={id.map} class="scroll-mt-24 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-3">{T.mapH}</h2>
      <p class="text-slate-400 leading-relaxed max-w-2xl mb-8">{T.mapLede}</p>

      <figure class="mb-10" data-theme-figure>
        <div class="theme-shot" data-shot="light">
          <a href={`${img('fullscreen-light')}-1920.webp`} class="zoom" aria-label={T.openFull}>
            <Screenshot src={img('fullscreen-light')} widths={[1920, 1100]} width={1920} height={1200} alt={T.fullAltLight}
              sizes="(min-width: 1152px) 1056px, calc(100vw - 32px)" class="shot" />
          </a>
        </div>
        <div class="theme-shot" data-shot="dark" hidden>
          <a href={`${img('fullscreen-dark')}-1920.webp`} class="zoom" aria-label={T.openFull}>
            <Screenshot src={img('fullscreen-dark')} widths={[1920, 1100]} width={1920} height={1200} alt={T.fullAltDark}
              sizes="(min-width: 1152px) 1056px, calc(100vw - 32px)" class="shot" />
          </a>
        </div>
        <figcaption class="cap flex flex-wrap items-center justify-between gap-3">
          <span>{T.fullCap}</span>
          <span class="seg" role="group" aria-label={T.themeLabel} hidden>
            <button type="button" data-theme-btn="light" aria-pressed="true">{T.light}</button>
            <button type="button" data-theme-btn="dark" aria-pressed="false">{T.dark}</button>
          </span>
        </figcaption>
      </figure>

      <div class="gallery">
        <figure class="g-detail">
          <a href={`${img('chat-detail')}-1440.webp`} class="zoom" aria-label={T.openFull}>
            <Screenshot src={img('chat-detail')} widths={[1440, 720]} width={1440} height={1074} alt={T.detailAlt}
              sizes="(min-width: 1152px) 600px, (min-width: 1024px) 52vw, calc(100vw - 32px)" class="shot" />
          </a>
          <figcaption class="cap">{T.detailCap}</figcaption>
        </figure>
        <figure class="g-phone">
          <a href={`${img('phone-light')}-720.webp`} class="zoom" aria-label={T.openFull}>
            <Screenshot src={img('phone-light')} widths={[720]} width={720} height={974} alt={T.phoneAlt}
              sizes="(min-width: 1024px) 220px, calc(50vw - 24px)" class="shot shot-phone" />
          </a>
          <figcaption class="cap">{T.phoneCap}</figcaption>
        </figure>
        <figure class="g-phone">
          <a href={`${img('phone-fullscreen-dark')}-720.webp`} class="zoom" aria-label={T.openFull}>
            <Screenshot src={img('phone-fullscreen-dark')} widths={[720]} width={720} height={1330} alt={T.phoneFullAlt}
              sizes="(min-width: 1024px) 220px, calc(50vw - 24px)" class="shot shot-phone" />
          </a>
          <figcaption class="cap">{T.phoneFullCap}</figcaption>
        </figure>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mt-12">
        <div>
          <h3 class="text-lg font-semibold text-slate-100 mb-3">{T.keyH}</h3>
          <dl class="defs">
            {T.key.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
          </dl>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-slate-100 mb-3">{T.buttonsH}</h3>
          <dl class="defs">
            {T.buttons.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Near me -->
    <section id={id.near} class="scroll-mt-24 mb-20">
      <div class="grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-8 lg:gap-14 items-center">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-3">{T.nearH}</h2>
          <p class="text-slate-400 leading-relaxed mb-5">{T.nearLede}</p>
          <ul class="near-ways">
            <li><span>{T.nearWays[0]}</span> <span class="bubble">{T.nearSay}</span></li>
            <li set:html={T.nearWays[1]} />
          </ul>
          <p class="text-slate-400 leading-relaxed mt-6 mb-2">{T.nearThen}</p>
          <p class="bubble mb-6">{T.nearAsk}</p>
          <p class="text-sm text-slate-500 leading-relaxed">{T.nearNote}</p>
        </div>
        <figure>
          <Screenshot src={img('near-me')} widths={[1440, 720]} width={1440} height={1074} alt={T.nearAlt}
            sizes="(min-width: 1152px) 620px, (min-width: 1024px) 54vw, calc(100vw - 32px)" class="shot" />
        </figure>
      </div>
    </section>

    <!-- Limits -->
    <section id={id.limits} class="scroll-mt-24 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-3">{T.limitsH}</h2>
      <p class="text-slate-400 leading-relaxed max-w-2xl mb-6">{T.limitsLede}</p>
      <div class="overflow-x-auto">
        <table class="limits">
          <caption class="sr-only">{T.limitsCaption}</caption>
          <thead><tr>{T.limitsCols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
          <tbody>
            {PLANS.map((p) => (
              <tr>
                <th scope="row">{planName(p.id)} <span>{p.priceEur ? T.perMonth(p.priceEur) : T.free}</span></th>
                <td>{nf.format(p.perMin)}</td>
                <td>{nf.format(p.perMonth)}</td>
                <td>{p.maxRadiusKm ? `${nf.format(p.maxRadiusKm)} km` : T.worldwide}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {T.limitsNote && <p class="text-xs text-slate-500 mt-3">{T.limitsNote}</p>}
      <p class="mt-4 text-sm"><a href={href.plans} class="text-sky-400 no-underline hover:text-sky-300">{T.limitsLink}</a></p>
    </section>

    <!-- Privacy -->
    <section id={id.privacy} class="scroll-mt-24 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-6">{T.privacyH}</h2>
      <table class="spec-table privacy-table">
        {T.privacy.map(([k, v]) => (
          <tr>
            <td class="k" style="font-family:inherit;color:#e2e8f0">{k}</td>
            <td class="d" set:html={v} />
          </tr>
        ))}
      </table>
      <p class="mt-4 text-sm"><a href={href.privacy} class="text-sky-400 no-underline hover:text-sky-300">{T.privacyLink}</a></p>
    </section>

    <!-- FAQ: the same questions as the FAQPage JSON-LD above. -->
    <section id={id.faq} class="scroll-mt-24 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-6">{T.faqH}</h2>
      <FaqList faqs={faqs} lang={lang} />
      <p class="mt-4 text-sm"><a href={it ? '/faq/' : '/en/faq/'} class="text-sky-400 no-underline hover:text-sky-300">{T.faqAll}</a></p>
    </section>

    <!-- Docs -->
    <section id={id.docs} class="scroll-mt-24">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-6">{T.docsH}</h2>
      <ul class="doclinks">
        {T.docs.map((d) => (
          <li><a href={d.href}><span class="dl-label">{d.label}</span><span class="dl-desc">{d.desc}</span></a></li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<style>
  .btn-primary {
    display: inline-flex; align-items: center;
    padding: 0.7rem 1.25rem; border-radius: 0.5rem;
    background: #38bdf8; color: #070d1a; font-weight: 600; font-size: 0.9rem;
    text-decoration: none; transition: background-color 0.15s;
  }
  .btn-primary:hover { background: #7dd3fc; color: #070d1a; }
  .copy-url {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.65rem 0.95rem; border-radius: 0.5rem;
    background: #111e30; color: #cbd5e1; border: 1px solid #2a3f5c;
    font-size: 0.85rem; cursor: pointer; transition: border-color 0.15s, color 0.15s;
  }
  .copy-url:hover { border-color: #38bdf8; color: #f0f9ff; }
  .copy-status { color: #34d399; min-width: 1px; }

  /* The conversation around the screenshot: neutral on purpose, it imitates
     no assistant's UI. Prompts are the only bubbles on the page. */
  .chat {
    margin: 0;
    padding: 18px;
    border-radius: 22px;
    background: #0b1526;
    border: 1px solid #1e3048;
    box-shadow: 0 30px 80px -40px #000;
  }
  .bubble {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    border-radius: 16px 16px 4px 16px;
    background: #17304d;
    color: #e6f0fb;
    font-size: 0.92rem;
    line-height: 1.45;
  }
  /* Quoted for screen readers too; «» in Italian, as in the rest of the site. */
  .bubble { quotes: "“" "”"; }
  :global(html[lang="it"]) .bubble { quotes: "«" "»"; }
  .bubble::before { content: open-quote; color: #7dd3fc; margin-right: 1px; }
  .bubble::after { content: close-quote; color: #7dd3fc; margin-left: 1px; }
  .chat .bubble { display: table; margin: 0 0 0 auto; max-width: 88%; }
  .chat .bubble::before, .chat .bubble::after { content: none; }
  .bubble-lg { font-size: 1rem; padding: 0.65rem 1rem; }
  .call {
    display: flex; align-items: center; gap: 0.45rem;
    margin: 16px 0 10px;
    font: 500 12px/1.4 "JetBrains Mono", ui-monospace, monospace;
    color: #8391a7;
    overflow-wrap: anywhere;
  }
  .call svg { color: #a78bfa; flex: none; }
  .call b { color: #c4b5fd; font-weight: 600; }
  .widget :global(img) { display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid #22344f; }
