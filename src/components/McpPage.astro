  /* One moment on load: the question, the call, the map, the answer, in the
     order they happen in a chat. The map moves but is never transparent: it
     is the page's largest image. */
  @media (prefers-reduced-motion: no-preference) {
    .chat-in { animation: chat-in 420ms ease-out both; animation-delay: var(--d); }
    .chat-rise { animation: chat-rise 520ms cubic-bezier(.2,.7,.2,1) both; animation-delay: var(--d); }
  }
  @keyframes chat-in { from { opacity: 0; transform: translateY(6px); } }
  @keyframes chat-rise { from { transform: translateY(14px); } }

  /* Connect: tabs once the script runs; without it, the three panels one
     after the other, each with its heading. */
  .tablist[hidden], .seg[hidden] { display: none; }
  .tablist { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px; margin-bottom: 1.25rem; border-radius: 0.6rem; background: #0a1320; border: 1px solid #1e3048; width: fit-content; max-width: 100%; }
  .tablist button {
    padding: 0.5rem 0.9rem; border-radius: 0.45rem; font-size: 0.9rem; font-weight: 500;
    color: #94a3b8; background: transparent; cursor: pointer; transition: color 0.15s, background-color 0.15s;
  }
  .tablist button:hover { color: #e2e8f0; }
  .tablist button[aria-selected="true"] { background: #17304d; color: #f0f9ff; }
  .panel { padding: 1.5rem; border-radius: 0.9rem; background: #0a1320; border: 1px solid #1e3048; }
