  .privacy-table td.k { padding-left: 0; width: 13rem; white-space: normal; }
  @media (max-width: 640px) { .privacy-table td.k, .privacy-table td.d { padding-left: 0; padding-right: 0; } }
  .doclinks { display: grid; gap: 0; border-top: 1px solid #1e3048; }
