  .copy-inline:hover { border-color: #38bdf8; }
  .copy-inline code { font-size: 0.85rem; color: #7dd3fc; overflow-wrap: anywhere; }
  .copy-label { font-size: 0.75rem; color: #94a3b8; flex: none; }
  .panel-note { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid #1a2a40; color: #8391a7; font-size: 0.85rem; line-height: 1.55; }
  .code { position: relative; }
  .code pre, .raw pre {
    margin: 0; padding: 1rem 1.1rem; border-radius: 0.6rem; overflow-x: auto;
    background: #070d1a; border: 1px solid #1e3048; color: #cbd5e1; font-size: 0.8rem; line-height: 1.65;
  }
  .code pre { padding-right: 4.5rem; }
  .code-copy {
    position: absolute; top: 0.55rem; right: 0.55rem; padding: 0.3rem 0.6rem; border-radius: 0.4rem;
    font-size: 0.75rem; color: #cbd5e1; background: #111e30; border: 1px solid #2a3f5c; cursor: pointer;
  }
  .code-copy:hover { border-color: #38bdf8; }
  .others { margin-top: 1.25rem; display: grid; gap: 0.75rem; }
  .others li { position: relative; padding-left: 1rem; color: #94a3b8; font-size: 0.9rem; line-height: 1.6; }
  .others li::before { content: ""; position: absolute; left: 0; top: 0.65em; width: 5px; height: 5px; border-radius: 50%; background: #3b5577; }
  .others :global(strong) { color: #e2e8f0; font-weight: 600; }
  .others :global(code) { font-size: 0.8rem; color: #7dd3fc; }
  .raw { margin-top: 1.25rem; }
  .raw summary { cursor: pointer; color: #94a3b8; font-size: 0.85rem; }
  .raw summary:hover { color: #e2e8f0; }
  .raw pre { margin-top: 0.75rem; font-size: 0.75rem; white-space: pre-wrap; overflow-wrap: anywhere; }
  .signin { margin: 0; }
  .signin :global(.shot-signin) { max-width: 388px; }

  /* Screenshots */
  :global(.mcp .shot) { display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid #22344f; background: #0a1320; }
  :global(.mcp .shot-phone) { border-radius: 20px; }
  .zoom { display: block; border-radius: 12px; }
  .cap { margin-top: 0.75rem; color: #8391a7; font-size: 0.85rem; line-height: 1.55; }
  .gallery { display: grid; gap: 2rem 1.5rem; grid-template-columns: 1fr 1fr; align-items: start; }
  .gallery figure { margin: 0; }
  .g-detail { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .gallery { grid-template-columns: minmax(0, 6fr) minmax(0, 2.6fr) minmax(0, 2.6fr); }
    .g-detail { grid-column: auto; }
  }
  .seg { display: inline-flex; padding: 3px; border-radius: 0.5rem; background: #0a1320; border: 1px solid #1e3048; }
  .seg button { padding: 0.3rem 0.75rem; border-radius: 0.35rem; font-size: 0.8rem; color: #94a3b8; cursor: pointer; }
  .seg button[aria-pressed="true"] { background: #17304d; color: #f0f9ff; }

  /* Tools: grouped by what you want to know; the group is the label column. */
  .toolgroup { display: grid; gap: 0.75rem 2rem; padding: 1.5rem 0; border-top: 1px solid #1e3048; }
  .toolgroup:last-child { border-bottom: 1px solid #1e3048; }
  @media (min-width: 768px) { .toolgroup { grid-template-columns: 11rem minmax(0, 1fr); } }
  .group-name { font-size: 0.95rem; font-weight: 600; color: #94a3b8; padding-top: 0.15rem; }
  .toollist { display: grid; gap: 1.75rem; }
  @media (min-width: 1024px) { .toollist { grid-template-columns: 1fr 1fr; } }
  .tool-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: 0.35rem; }
  .tool-name { font: 600 0.95rem/1.3 "JetBrains Mono", monospace; color: #c4b5fd; }
  .tag-map { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.72rem; color: #7dd3fc; padding: 0.15rem 0.5rem; border-radius: 999px; border: 1px solid #23476a; }
