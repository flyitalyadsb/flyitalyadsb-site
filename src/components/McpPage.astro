    width: 1.6rem; height: 1.6rem; border-radius: 999px; display: grid; place-items: center;
    font: 600 12px/1 "JetBrains Mono", monospace; color: #7dd3fc; border: 1px solid #2a4a6b; background: #0f1d31;
  }
  .steps :global(strong) { color: #f0f9ff; font-weight: 600; }
  .steps :global(a), .others :global(a), .cap :global(a), .near-ways :global(a), .spec-table :global(a) { color: #38bdf8; text-decoration: none; }
  .steps :global(a:hover), .others :global(a:hover), .cap :global(a:hover), .near-ways :global(a:hover), .spec-table :global(a:hover) { color: #7dd3fc; }
