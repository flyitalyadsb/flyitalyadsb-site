    display: inline-flex; align-items: center;
    padding: 0.7rem 1.25rem; border-radius: 0.5rem;
    background: #38bdf8; color: #070d1a; font-weight: 600; font-size: 0.9rem;
    text-decoration: none; transition: background-color 0.15s; cursor: pointer;
  }
  .btn-primary:hover { background: #7dd3fc; color: #070d1a; }
  .btn-primary:disabled { opacity: 0.6; cursor: progress; }
  .btn-ghost {
    display: inline-flex; align-items: center;
    padding: 0.7rem 1.25rem; border-radius: 0.5rem;
    background: #111e30; color: #e2e8f0; border: 1px solid #2a3f5c; font-weight: 500; font-size: 0.9rem;
    text-decoration: none; transition: border-color 0.15s, color 0.15s;
  }
  .btn-ghost:hover { border-color: #38bdf8; color: #f0f9ff; }
  .btn-violet:hover { border-color: #a78bfa; }

  .mapframe { position: relative; }
  :global(.api .mapimg) { display: block; width: 100%; height: auto; border-radius: 14px; border: 1px solid #22344f; }
  .mapreq {
    position: absolute; left: 12px; bottom: 12px; max-width: calc(100% - 24px);
    padding: 0.45rem 0.7rem; border-radius: 0.45rem;
    background: #070d1ae6; border: 1px solid #2a3f5c; color: #e2e8f0;
    font-size: 0.75rem; overflow-wrap: anywhere;
    backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
  }
  .mapreq span { color: #38bdf8; font-weight: 600; margin-right: 0.35rem; }
  .cap { margin-top: 0.75rem; color: #8391a7; font-size: 0.82rem; line-height: 1.55; }

  .steps { counter-reset: step; display: grid; gap: 1.6rem; }
  .steps > li { counter-increment: step; position: relative; padding-left: 2.6rem; }
  .steps > li:not(.steps-more)::before {
    content: counter(step); position: absolute; left: 0; top: 0;
    width: 1.7rem; height: 1.7rem; border-radius: 999px; display: grid; place-items: center;
    font: 600 12px/1 "JetBrains Mono", monospace; color: #7dd3fc; border: 1px solid #2a4a6b; background: #0f1d31;
  }
  .steps h3 { font-size: 1rem; font-weight: 600; color: #f0f9ff; margin-bottom: 0.3rem; line-height: 1.7rem; }
  .steps p { color: #94a3b8; font-size: 0.92rem; line-height: 1.6; }
  .steps-more a { font-size: 0.9rem; color: #38bdf8; text-decoration: none; }
  .steps-more a:hover { color: #7dd3fc; }
  .steps :global(code), .prose-links :global(code) { white-space: nowrap; font-size: 0.82em; color: #7dd3fc; background: #111e30; padding: 0.05rem 0.3rem; border-radius: 0.25rem; }
  .steps :global(a), .prose-links :global(a), .d :global(a) { color: #38bdf8; text-decoration: none; }
  .steps :global(a:hover), .prose-links :global(a:hover) { color: #7dd3fc; }

  .terminal { border-radius: 0.9rem; border: 1px solid #1e3048; background: #070d1a; overflow: hidden; }
  .term-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.55rem 1rem; background: #0a1320; border-bottom: 1px solid #1e3048; font-size: 0.75rem; color: #8391a7; }
  .term-sep { border-top: 1px solid #1e3048; }
  .term-copy { padding: 0.2rem 0.55rem; border-radius: 0.35rem; color: #cbd5e1; background: #111e30; border: 1px solid #2a3f5c; cursor: pointer; font-size: 0.75rem; }
  .term-copy:hover { border-color: #38bdf8; }
  .terminal pre { margin: 0; padding: 1rem 1.1rem; overflow-x: auto; font-size: 0.8rem; line-height: 1.7; color: #cbd5e1; }
  .terminal :global(.j-k) { color: #7dd3fc; }
  .terminal :global(.j-s) { color: #e2e8f0; }
  .terminal :global(.j-n) { color: #fcd34d; }

  .epgroup { margin-bottom: 2rem; }
  .epgroup-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; }
  .epgroup-head h3 { font-size: 1rem; font-weight: 600; color: #e2e8f0; }
  .epgroup-head a { font-size: 0.82rem; color: #38bdf8; text-decoration: none; }
  .epgroup-head a:hover { color: #7dd3fc; }
  .eptable { table-layout: fixed; }
  .eptable td.k { width: 25.5rem; white-space: normal; overflow-wrap: anywhere; }
  @media (max-width: 640px) { .eptable td.k { width: auto; } }
  .m { display: inline-block; min-width: 2.7rem; margin-right: 0.6rem; font-size: 11px; color: #8391a7; }
  .m-post { color: #fbbf24; }
  .ep-tag { display: inline-block; margin-left: 0.5rem; padding: 0.05rem 0.5rem; border-radius: 999px; border: 1px solid #5b4a1e; color: #fcd34d; font-size: 0.72rem; white-space: nowrap; }

  .field { width: 100%; padding: 0.65rem 0.75rem; border-radius: 0.5rem; font-size: 0.875rem; background: #111e30; color: #e2e8f0; border: 1px solid var(--color-input-border); }

  .mcpcard { display: grid; gap: 1.5rem 2.5rem; align-items: center; padding: 1.25rem; border-radius: 1rem; background: #0b1526; border: 1px solid #1e3048; }
  @media (min-width: 768px) { .mcpcard { grid-template-columns: minmax(0, 360px) minmax(0, 1fr); padding: 1.5rem; } }
  :global(.api .mcpshot) { display: block; width: 100%; height: auto; border-radius: 10px; border: 1px solid #22344f; }
  .mcpcard-img { display: block; }

  .doclinks { display: grid; border-top: 1px solid #1e3048; }
  .doclinks a { display: grid; gap: 0.15rem 1.5rem; padding: 0.9rem 0; border-bottom: 1px solid #1e3048; text-decoration: none; }
  @media (min-width: 640px) { .doclinks a { grid-template-columns: 13rem minmax(0, 1fr); } }
  .dl-label { color: #38bdf8; font-weight: 600; font-size: 0.95rem; }
  .doclinks a:hover .dl-label { color: #7dd3fc; }
  .dl-desc { color: #94a3b8; font-size: 0.9rem; line-height: 1.5; }
</style>

<script>
  import { identify, track } from '../lib/analytics';

  // Old links to the MCP section of this page (#mcp, and the "how to connect"
  // anchors of both languages) go to the MCP page, which has it all now. A
  // fragment never reaches the server, so this can't be a _redirects rule.
  {
    const en = location.pathname.startsWith('/en/');
    const to: Record<string, string> = en
      ? { '#mcp': '/en/data/mcp/', '#connect-claude': '/en/data/mcp/#connect' }
      : { '#mcp': '/dati/mcp/', '#come-collegarlo': '/dati/mcp/#collega' };
    const dest = to[location.hash];
    if (dest) location.replace(dest);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(btn.dataset.copy || ''); } catch { return; }
      const before = btn.textContent;
      btn.textContent = btn.dataset.done || '';
      setTimeout(() => { btn.textContent = before; }, 2000);
    });
  });

  const form = document.getElementById('key-form') as HTMLFormElement | null;
  if (form) {
    const msgs = JSON.parse(form.dataset.msgs || '{}') as Record<string, string>;
    const lang = form.dataset.lang || 'it';
    const submitBtn = document.getElementById('key-submit') as HTMLButtonElement;
    const status = document.getElementById('key-status') as HTMLParagraphElement;
    const setStatus = (text: string, color: string) => { status.textContent = text; status.style.color = color; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('key-email') as HTMLInputElement).value.trim();
      const name = (document.getElementById('key-name') as HTMLInputElement).value.trim();
      const useCase = (document.getElementById('key-use-case') as HTMLInputElement).value.trim();
      submitBtn.disabled = true;
      setStatus(msgs.sending, '#94a3b8');
      try {
        const res = await fetch('https://api.flyitalyadsb.com/v2/keys', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, name: name || undefined, use_case: useCase || undefined, lang }),
        });
        if (res.status === 202) identify(email);
        track('api_key_requested', { status: res.status });
        if (res.status === 202) {
          setStatus(msgs.ok, '#34d399');
          form.reset();
        } else if (res.status === 429) {
          setStatus(msgs.r429, '#fbbf24');
        } else if (res.status === 409) {
          setStatus(msgs.r409, '#fbbf24');
        } else if (res.status === 413) {
          setStatus(msgs.r413, '#f87171');
        } else {
          const body = await res.json().catch(() => null);
          setStatus(body?.error || msgs.fail, '#f87171');
        }
      } catch {
        setStatus(msgs.offline, '#f87171');
      } finally {
        submitBtn.disabled = false;
      }
    });
  }
</script>
