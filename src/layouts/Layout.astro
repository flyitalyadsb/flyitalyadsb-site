---
import Analytics from '../components/Analytics.astro';
import { otherLanguagePath } from '../lib/routes';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** OG/Twitter image, absolute path from site root. Defaults to the branded card. */
  image?: string;
  /** Set true to keep the page out of search indexes. */
  noindex?: boolean;
  /** og:type — 'website' (default) or 'article'. */
  ogType?: string;
  /** Extra JSON-LD block(s) injected into <head> (object or array). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const SITE = 'https://flyitalyadsb.com';

// Language detection
const path = Astro.url.pathname;
const isEn = path.startsWith('/en') && (path === '/en' || path.startsWith('/en/'));
const lang = isEn ? 'en' : 'it';

const {
  title,
  description = isEn
    ? 'Open, unfiltered ADS-B & MLAT data — a global network born in Italy, 3,200+ direct feeders, our own multilateration, weather research. A community network.'
    : 'Dati ADS-B e MLAT aperti e non filtrati — rete globale nata in Italia, oltre 3.200 feeder diretti, multilaterazione propria, ricerca meteo. Rete community.',
  image = '/og.png',
  noindex = false,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL(SITE)).origin;
// Directory build format → pathnames carry a trailing slash; keep it so canonical
// and hreflang match the URL the server actually serves (no 3xx redirect).
const abs = (p: string) => new URL(p, siteOrigin).href;
const canonicalURL = abs(path);
const imageURL = new URL(image, siteOrigin).href;

// Language switcher + hreflang: the same page in the other language. English
// pages have English paths since 2026-10-18 (src/lib/routes.ts), so this is a
// mapping, not just adding/removing the /en prefix. Trailing slash preserved.
const altLangPath = otherLanguagePath;
// The 404 page (one, bilingual) has no other-language twin: its switch goes to
// the other language's home and it publishes no hreflang.
const is404 = /^\/404(\.html|\/)?$/.test(path);
const altHref = is404 ? (isEn ? '/' : '/en/') : altLangPath(path);
const altLabel = isEn ? 'IT' : 'EN';

// hreflang alternates (absolute)
const itHref = abs(isEn ? altLangPath(path) : path);
const enHref = abs(isEn ? path : altLangPath(path));

// Site-wide structured data + optional per-page blocks
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FlyItalyADSB',
  url: SITE,
  logo: `${SITE}/logo.png`,
  description: isEn
    ? 'Community network born in Italy collecting open ADS-B, Mode-S and MLAT aircraft data worldwide.'
    : 'Rete community nata in Italia che raccoglie dati aeronautici ADS-B, Mode-S e MLAT aperti in tutto il mondo.',
  sameAs: ['https://github.com/flyitalyadsb'],
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FlyItalyADSB',
  url: SITE,
  inLanguage: lang === 'en' ? 'en-US' : 'it-IT',
};
const jsonLdBlocks = [
  orgLd,
  websiteLd,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];

const nav = isEn
  ? { map: 'Map', airports: 'Airports', aircraft: 'Aircraft', data: 'Data', network: 'Network', research: 'Research', about: 'About' }
  : { map: 'Mappa', airports: 'Aeroporti', aircraft: 'Aeromobili', data: 'Dati', network: 'Rete', research: 'Ricerca', about: 'Chi siamo' };

// Sub-pages the top row alone never reached (feeder, MLAT, contact, the
// archive): same groups as the footer. On desktop they open on hover or
// keyboard focus; in the phone menu they are listed under their section.
// `match` = other path prefixes that count as the section (/community → Rete).
type NavChild = { href: string; label: string };
type NavLink = { href: string; label: string; external: boolean; match?: string[]; children?: NavChild[] };
const navLinks: NavLink[] = isEn
  ? [
      { href: 'https://mappa.flyitalyadsb.com', label: nav.map, external: true },
      { href: '/en/airports/', label: nav.airports, external: false },
      { href: '/en/aircraft/', label: nav.aircraft, external: false },
      { href: '/en/data/', label: nav.data, external: false, children: [
          { href: '/en/data/', label: 'About our data' },
          { href: '/en/data/archive/', label: 'Archive' },
          { href: '/en/data/api/', label: 'REST API' },
          { href: '/en/data/mcp/', label: 'MCP and AI agents' },
          { href: '/en/data/api/docs/', label: 'API documentation' },
          { href: '/en/data/comparison/', label: 'API comparison' },
        ] },
      { href: '/en/network/', label: nav.network, external: false, match: ['/en/community'], children: [
          { href: '/en/network/', label: 'The network' },
          { href: '/en/community/feeder/', label: 'Become a feeder' },
          { href: '/en/community/feeder-status/', label: 'Is my data arriving?' },
          { href: '/en/community/mlat/', label: 'How MLAT works' },
        ] },
      { href: '/en/research/', label: nav.research, external: false, children: [
          { href: '/en/research/', label: 'All projects' },
          { href: '/en/research/weather/', label: 'weather32' },
        ] },
      { href: '/en/about/', label: nav.about, external: false, match: ['/en/contact/', '/en/faq/'], children: [
          { href: '/en/about/', label: 'About' },
          { href: '/en/faq/', label: 'FAQ' },
          { href: '/en/contact/', label: 'Contact us' },
        ] },
    ]
  : [
      { href: 'https://mappa.flyitalyadsb.com', label: nav.map, external: true },
      { href: '/aeroporti/', label: nav.airports, external: false },
      { href: '/aeromobili/', label: nav.aircraft, external: false },
      { href: '/dati/', label: nav.data, external: false, children: [
          { href: '/dati/', label: 'I nostri dati' },
          { href: '/dati/archivio/', label: 'Archivio storico' },
          { href: '/dati/api/', label: 'API REST' },
          { href: '/dati/mcp/', label: 'MCP e agenti AI' },
          { href: '/dati/api/docs/', label: 'Documentazione API' },
          { href: '/dati/confronto/', label: 'Confronto API' },
        ] },
      { href: '/rete/', label: nav.network, external: false, match: ['/community'], children: [
          { href: '/rete/', label: 'La rete' },
          { href: '/community/feeder/', label: 'Diventa feeder' },
          { href: '/community/stato-feeder/', label: 'I miei dati arrivano?' },
          { href: '/community/mlat/', label: 'Come funziona MLAT' },
        ] },
      { href: '/ricerca/', label: nav.research, external: false, children: [
          { href: '/ricerca/', label: 'Tutti i progetti' },
          { href: '/ricerca/weather/', label: 'weather32' },
        ] },
      { href: '/chi-siamo/', label: nav.about, external: false, match: ['/contatti/', '/faq/'], children: [
          { href: '/chi-siamo/', label: 'Chi siamo' },
          { href: '/faq/', label: 'Domande frequenti' },
          { href: '/contatti/', label: 'Contattaci' },
        ] },
    ];

// Called out separately from navLinks (own accent styling, not a plain text
// link) so the API/MCP docs — the thing an adsb.lol-style visitor actively
// looks for — read as a distinct destination instead of blending into the
// content nav next to "Rete" or "Ricerca".
const apiHref = isEn ? '/en/data/api/' : '/dati/api/';
// Section of the current page, for aria-current on the nav (a section link
// stays current on its sub-pages: /aeroporti/pisa/ → Aeroporti).
const here = Astro.url.pathname.replace(/\/+$/, '');
const isCurrent = (href: string) => {
  if (href.startsWith('http')) return false;
  const h = href.replace(/\/+$/, '');
  return here === h || here.startsWith(h + '/');
};
const isSection = (link: NavLink) => isCurrent(link.href) || (link.match ?? []).some(isCurrent);
// "page" only on the section's own page; on its sub-pages the section is
// "true" (current item of the set) and the sub-page link carries "page".
const sectionAria = (link: NavLink) =>
  !isSection(link) ? undefined : here === link.href.replace(/\/+$/, '') ? 'page' : 'true';
// A child that repeats its section's own page is current only on that exact
// page, or "I nostri dati" would light up on every /dati/* page.
const isChildCurrent = (link: NavLink, child: NavChild) =>
  child.href === link.href ? here === child.href.replace(/\/+$/, '') : isCurrent(child.href);
const apiLabel = 'API & MCP';
---

<!doctype html>
<html lang={lang} data-page-type={is404 ? 'not_found' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#070d1a" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <title>{title} — FlyItalyADSB</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang alternates -->
    {!is404 && <link rel="alternate" hreflang="it" href={itHref} />}
    {!is404 && <link rel="alternate" hreflang="en" href={enHref} />}
    {!is404 && <link rel="alternate" hreflang="x-default" href={itHref} />}

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} — FlyItalyADSB`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="FlyItalyADSB" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'it_IT'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'it_IT' : 'en_US'} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FlyItalyADSB — open ADS-B and MLAT flight tracking data" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — FlyItalyADSB`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- global.css's `code, pre` rule has named "JetBrains Mono" as the
         monospace face since before this pass, but nothing ever loaded it —
         every code block on the site has silently been rendering in the
         system monospace fallback. Also used directly (not just code/pre)
         by the .hud-readout/.spec-table/.timeline/.tag-row primitives. -->
    <!-- Self-hosted since 2026-10-18 (global.css @font-face): no third-party
         stylesheet blocking the first paint. Preload the latin subset, the
         one every page uses above the fold (HUD, eyebrow labels). -->
    <link rel="preload" href="/fonts/jetbrains-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col" style="background-color:#070d1a">

    <!-- Nav -->
    <!-- Never fully transparent: the homepage hero is a live, busy map
         (magenta/purple aircraft icons). A soft transparent-at-the-bottom
         gradient scrim fixed the legibility bug but still let the map's
         colors compete with the text — solid + blurred from the start,
         same as the scroll-triggered state below, reads much cleaner. -->
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:px-3 focus:py-2 focus:rounded focus:text-sm"
       style="background:#111e30;color:#e2e8f0">{isEn ? 'Skip to content' : 'Salta al contenuto'}</a>

    <nav id="navbar" aria-label={isEn ? 'Main' : 'Principale'} class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
         style="background:#070d1aee;backdrop-filter:blur(12px)">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">

        <a href={isEn ? '/en/' : '/'} class="flex items-center gap-2 no-underline group">
          <img src="/img/logo-64.png" alt="" width="26" height="26" class="rounded-full" />
          <span class="font-semibold text-sm tracking-wide text-slate-100 group-hover:text-white transition-colors">
            FlyItalyADSB
          </span>
        </a>

        <!-- Full row from lg (1024px) up. Below that the seven links + API +
             language did not fit and pushed the whole page wider than the
             phone (390px: everything cut on the right, 2026-10-18): they move
             into the #nav-menu panel, API and language stay in the bar. -->
        <div class="hidden lg:flex items-center gap-1 text-sm">
          {navLinks.map(link => link.children ? (
            <div class="relative group">
              <a href={link.href}
                 aria-current={sectionAria(link)}
                 class={`inline-flex items-center gap-1 px-3 py-1.5 rounded hover:text-slate-100 hover:bg-white/5 transition-colors no-underline ${isSection(link) ? 'text-slate-100 bg-white/5' : 'text-slate-400'}`}>
                {link.label}
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="opacity-60">
                  <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <!-- pt-2, not a margin: the gap stays inside the hover area. -->
              <div class="absolute left-0 top-full pt-2 hidden group-hover:block group-focus-within:block">
                <ul class="min-w-52 py-1.5 rounded-lg border shadow-xl" style="background:#0f1929;border-color:#1e3048">
                  {link.children.map(child => (
                    <li>
                      <a href={child.href}
                         aria-current={isChildCurrent(link, child) ? 'page' : undefined}
                         class={`block px-3.5 py-2 whitespace-nowrap hover:text-slate-100 hover:bg-white/5 transition-colors no-underline ${isChildCurrent(link, child) ? 'text-slate-100' : 'text-slate-400'}`}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a href={link.href}
               target={link.external ? '_blank' : undefined}
               rel={link.external ? 'noopener' : undefined}
               aria-current={isCurrent(link.href) ? 'page' : undefined}
               class={`px-3 py-1.5 rounded hover:text-slate-100 hover:bg-white/5 transition-colors no-underline ${isCurrent(link.href) ? 'text-slate-100 bg-white/5' : 'text-slate-400'}`}>
              {link.label}{link.external ? ' ↗' : ''}
            </a>
          ))}
          <a href={apiHref}
             class="ml-1 px-3 py-1.5 rounded text-sm font-semibold no-underline transition-colors"
             style="color:#7dd3fc;border:1px solid #38bdf840;background:#38bdf812"
             onmouseover="this.style.background='#38bdf822'"
             onmouseout="this.style.background='#38bdf812'">
            {apiLabel}
          </a>
          <!-- Language switcher -->
          <a href={altHref} hreflang={isEn ? 'it' : 'en'} lang={isEn ? 'it' : 'en'} aria-label={isEn ? 'Italiano' : 'English'}
             class="ml-3 px-2.5 py-1 rounded text-xs font-mono font-semibold transition-colors no-underline"
             style="background:#ffffff08;color:#8391a7;border:1px solid #ffffff12"
             onmouseover="this.style.color='#94a3b8'"
             onmouseout="this.style.color='#8391a7'">
            {altLabel}
          </a>
        </div>

        <div class="flex lg:hidden items-center gap-2 text-sm">
          <a href={apiHref}
             class="px-3 py-1.5 rounded text-sm font-semibold no-underline"
             style="color:#7dd3fc;border:1px solid #38bdf840;background:#38bdf812">
            {apiLabel}
          </a>
          <a href={altHref} hreflang={isEn ? 'it' : 'en'} lang={isEn ? 'it' : 'en'} aria-label={isEn ? 'Italiano' : 'English'}
             class="px-2.5 py-1 rounded text-xs font-mono font-semibold no-underline"
             style="background:#ffffff08;color:#94a3b8;border:1px solid #ffffff12">
            {altLabel}
          </a>
          <button type="button" id="nav-toggle" aria-controls="nav-menu" aria-expanded="false"
                  aria-label={isEn ? 'Open menu' : 'Apri il menu'}
                  data-label-open={isEn ? 'Open menu' : 'Apri il menu'}
                  data-label-close={isEn ? 'Close menu' : 'Chiudi il menu'}
                  class="p-2 -mr-2 rounded text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path class="nav-icon-open" d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
              <path class="nav-icon-close hidden" d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
            </svg>
          </button>
        </div>

      </div>

      <!-- Scrolls on its own: with the sub-pages it can be taller than a
           phone held sideways, and the bar is fixed. -->
      <div id="nav-menu" class="lg:hidden hidden border-t max-h-[calc(100dvh-3.5rem)] overflow-y-auto" style="border-color:#1e3048">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2 flex flex-col">
          {navLinks.map(link => (
            <>
              <a href={link.href}
                 target={link.external ? '_blank' : undefined}
                 rel={link.external ? 'noopener' : undefined}
                 aria-current={link.children ? sectionAria(link) : isCurrent(link.href) ? 'page' : undefined}
                 class={`px-3 py-3 rounded text-base hover:text-white hover:bg-white/5 transition-colors no-underline ${isSection(link) ? 'text-white bg-white/5' : 'text-slate-300'}`}>
                {link.label}{link.external ? ' ↗' : ''}
              </a>
              {link.children && (
                <div class="flex flex-col ml-3 mb-1 border-l" style="border-color:#1e3048">
                  {link.children.filter(child => child.href !== link.href).map(child => (
                    <a href={child.href}
                       aria-current={isChildCurrent(link, child) ? 'page' : undefined}
                       class={`px-3 py-2 text-sm rounded hover:text-white hover:bg-white/5 transition-colors no-underline ${isChildCurrent(link, child) ? 'text-white' : 'text-slate-400'}`}>
                      {child.label}
                    </a>
                  ))}
                </div>
              )}
            </>
          ))}
        </div>
      </div>
    </nav>

    <!-- Slot content -->
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t mt-24 py-12 px-4" style="border-color:#1e3048;background:#070d1a">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-10">

          <div>
            <div class="flex items-center gap-2 mb-4">
              <img src="/img/logo-64.png" alt="" width="20" height="20" class="rounded-full" />
              <span class="text-slate-100 font-semibold text-sm">FlyItalyADSB</span>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">
              {isEn ? 'Open ADS-B data, global network born in Italy, our own MLAT. A community network.' : 'Dati ADS-B aperti, rete globale nata in Italia, MLAT proprio. Rete community.'}
            </p>
          </div>

          <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">{isEn ? 'Data' : 'Dati'}</div>
            <ul class="space-y-2 text-sm">
              <li><a href={isEn ? '/en/data/' : '/dati/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'About our data' : 'I nostri dati'}</a></li>
              <li><a href={isEn ? '/en/airports/' : '/aeroporti/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'Airports' : 'Aeroporti'}</a></li>
              <li><a href={isEn ? '/en/aircraft/' : '/aeromobili/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'Aircraft types' : 'Aeromobili'}</a></li>
              <li><a href={isEn ? '/en/data/archive/' : '/dati/archivio/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'Archive' : 'Archivio storico'}</a></li>
              <li><a href={isEn ? '/en/data/api/' : '/dati/api/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'REST API' : 'API REST'}</a></li>
              <li><a href={isEn ? '/en/data/mcp/' : '/dati/mcp/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'MCP and AI agents' : 'MCP e agenti AI'}</a></li>
              <li><a href={isEn ? '/en/data/api/docs/' : '/dati/api/docs/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'API documentation' : 'Documentazione API'}</a></li>
              <li><a href={isEn ? '/en/faq/' : '/faq/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'FAQ' : 'Domande frequenti'}</a></li>
            </ul>
          </div>

          <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">{isEn ? 'Community' : 'Community'}</div>
            <ul class="space-y-2 text-sm">
              <li><a href={isEn ? '/en/network/' : '/rete/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'The network' : 'La rete'}</a></li>
              <li><a href={isEn ? '/en/community/feeder/' : '/community/feeder/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'Become a feeder' : 'Diventa feeder'}</a></li>
              <li><a href={isEn ? '/en/community/feeder-status/' : '/community/stato-feeder/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'Is my data arriving?' : 'I miei dati arrivano?'}</a></li>
              <li><a href={isEn ? '/en/community/mlat/' : '/community/mlat/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'How MLAT works' : 'Come funziona MLAT'}</a></li>
              <li><a href={isEn ? '/en/research/' : '/ricerca/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'Research' : 'Ricerca'}</a></li>
            </ul>
          </div>

          <div>
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">{isEn ? 'Project' : 'Progetto'}</div>
            <ul class="space-y-2 text-sm">
              <li><a href={isEn ? '/en/about/' : '/chi-siamo/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'About' : 'Chi siamo'}</a></li>
              <li><a href={isEn ? '/en/contact/' : '/contatti/'} class="text-slate-500 hover:text-slate-300 no-underline">{isEn ? 'Contact us' : 'Contattaci'}</a></li>
              <li>
                <a href="https://github.com/flyitalyadsb" target="_blank" rel="noopener"
                   class="text-slate-500 hover:text-slate-300 no-underline">GitHub ↗</a>
              </li>
            </ul>
          </div>

        </div>

        <div class="border-t pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
             style="border-color:#1e3048">
          <p class="text-xs text-slate-600">
