{
  "name": "flyitalyadsb-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:links": "node scripts/check-links.mjs dist",
    "mcp:types": "wrangler types -c mcp-worker/wrangler.jsonc mcp-worker/worker-configuration.d.ts",
    "mcp:check": "npm run mcp:types && tsc -p mcp-worker",
    "mcp:dev": "wrangler dev -c mcp-worker/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "mcp:deploy": "wrangler deploy -c mcp-worker/wrangler.jsonc",
    "mcp:preview": "node mcp-worker/preview/serve.mjs",
    "status:types": "wrangler types -c status-worker/wrangler.jsonc status-worker/worker-configuration.d.ts",
    "status:check": "npm run status:types && tsc -p status-worker",
    "status:test": "node --experimental-strip-types --test status-worker/test/checks.test.ts",
    "status:dev": "wrangler dev -c status-worker/wrangler.jsonc --ip 127.0.0.1 --port 8791 --test-scheduled"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@posthog/mcp": "0.22.3",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.7",
    "leaflet": "1.9.4",
    "mcp-handler": "^2.1.1",
    "posthog-js": "1.436.1",
    "posthog-node": "5.55.1",
    "tailwindcss": "^4.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  }
}
