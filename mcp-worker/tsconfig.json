{
  // Typecheck only (wrangler bundles with esbuild). worker-configuration.d.ts
  // comes from `npx wrangler types -c mcp-worker/wrangler.jsonc mcp-worker/worker-configuration.d.ts`.
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
